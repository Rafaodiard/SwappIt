@*
    Mis intercambios (IntercambioController.Index): propuestas enviadas y recibidas del usuario logueado.
    Los filtros son links (?estado=Pendiente) con la cantidad de intercambios de cada estado (tabla EstadosIntercambios).
*@
@{
    ViewData["Title"] = "Mis intercambios";
    List<Swappit.Models.ViewModels.IntercambioViewModel> intercambios = ViewBag.intercambios;
    List<Swappit.Models.EstadosIntercambios> estados = ViewBag.estados;
    Dictionary<string, int> cantidadPorEstado = ViewBag.cantidadPorEstado;
    int total = ViewBag.total;
    string? estadoElegido = ViewBag.estadoElegido;
    bool errorCarga = ViewBag.errorCarga;
}

<div class="container-xl py-4 py-lg-5">
    <header class="mb-4">
        <h1 class="font-titulo display-5 text-primario mb-1">Mis intercambios</h1>
        <p class="text-suave mb-0">Seguí tus propuestas enviadas y recibidas.</p>
    </header>

    @if (errorCarga)
    {
        <div class="sw-card p-5 text-center">
            <i class="bi bi-exclamation-triangle fs-1 text-suave"></i>
            <h2 class="font-titulo h3 mt-3">No pudimos cargar tus intercambios</h2>
            <p class="text-suave mb-0">Hubo un problema al conectar con la base de datos. Probá de nuevo en un rato.</p>
        </div>
        return;
    }

    @if (total > 0)
    {
        <nav class="mb-3" aria-label="Filtrar por estado">
            <a href="@Url.Action("Index", "Intercambio")" class="sw-chip @(estadoElegido == null ? "activo" : "")" aria-current="@(estadoElegido == null ? "page" : null)">
                Todos <span class="sw-chip-cantidad">@total</span>
            </a>
            @foreach (var estado in estados)
            {
                bool elegido = estado.Nombre == estadoElegido;
                <a href="@Url.Action("Index", "Intercambio", new { estado = estado.Nombre })" class="sw-chip @(elegido ? "activo" : "")" aria-current="@(elegido ? "page" : null)">
                    @(estado.Nombre)s <span class="sw-chip-cantidad">@cantidadPorEstado.GetValueOrDefault(estado.Nombre ?? "")</span>
                </a>
            }
        </nav>
    }

    <section class="sw-card p-3 p-md-4" aria-label="Intercambios">
        @if (intercambios.Count > 0)
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var intercambio in intercambios)
                {
                    ViewBag.fila = intercambio;
                    <partial name="_FilaIntercambio" />
                }
            </div>
        }
        else if (total == 0)
        {
            <div class="text-center py-5 px-3">
                <i class="bi bi-arrow-left-right fs-1 text-suave"></i>
                <h2 class="font-titulo h3 mt-3">Todavía no tenés intercambios</h2>
                <p class="text-suave mb-4">Buscá un artículo que te guste y proponé un intercambio con uno de los tuyos.</p>
                <a href="@Url.Action("Buscar", "Articulos")" class="btn btn-sw-primario">Ver artículos</a>
            </div>
        }
        else
        {
            <div class="text-center py-5 px-3">
                <i class="bi bi-funnel fs-1 text-suave"></i>
                <p class="text-suave mt-2 mb-3">No tenés intercambios en estado @estadoElegido?.ToLowerInvariant().</p>
                <a href="@Url.Action("Index", "Intercambio")" class="btn btn-sw-outline btn-sm">Ver todos</a>
            </div>
        }
    </section>
</div>
