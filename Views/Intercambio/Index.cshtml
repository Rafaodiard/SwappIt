@{
    ViewData["Title"] = "Mis intercambios";
    List<Swappit.Models.ViewModels.IntercambioViewModel> intercambios = ViewBag.intercambios;
    List<Swappit.Models.ViewModels.FiltroEstadoViewModel> filtros = ViewBag.filtros;
    int total = ViewBag.total;
    string? estadoElegido = ViewBag.estadoElegido;
    bool errorCarga = ViewBag.errorCarga;
}

<div class="container-xl py-4 py-lg-5">
    <header class="mb-4">
        <h1 class="letra-serif display-5 texto-azul mb-1">Mis intercambios</h1>
        <p class="texto-suave mb-0">Seguí tus propuestas enviadas y recibidas.</p>
    </header>

    @if (errorCarga)
    {
        <div class="tarjeta-blanca p-5 text-center">
            <i class="bi bi-exclamation-triangle fs-1 texto-suave" aria-hidden="true"></i>
            <h2 class="letra-serif h3 mt-3">No pudimos cargar tus intercambios</h2>
            <p class="texto-suave mb-0">Hubo un problema al conectar con la base de datos. Probá de nuevo en un rato.</p>
        </div>
    }
    else
    {
        if (total > 0)
        {
            <nav class="mb-3" aria-label="Filtrar por estado">
                @foreach (var filtro in filtros)
                {
                    <a href="@Url.Action("Index", "Intercambio", new { estado = filtro.Nombre })" class="pastilla-blanca @(filtro.Elegido ? "activo" : "")" aria-current="@(filtro.Elegido ? "page" : null)">
                        @filtro.Texto <span class="numero-tenue">@filtro.Cantidad</span>
                    </a>
                }
            </nav>
        }

        <section class="tarjeta-blanca p-3 p-md-4" aria-label="Intercambios">
            @if (intercambios.Count > 0)
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var intercambio in intercambios)
                    {
                        ViewBag.fila = intercambio;
                        <partial name="_FilaIntercambio" />
                    }
                </div>
            }
            else if (total == 0)
            {
                <div class="text-center py-5 px-3">
                    <i class="bi bi-arrow-left-right fs-1 texto-suave" aria-hidden="true"></i>
                    <h2 class="letra-serif h3 mt-3">Todavía no tenés intercambios</h2>
                    <p class="texto-suave mb-4">Buscá un artículo que te guste y proponé un intercambio con uno de los tuyos.</p>
                    <a href="@Url.Action("Buscar", "Articulos")" class="btn boton-bordo">Ver artículos</a>
                </div>
            }
            else
            {
                <div class="text-center py-5 px-3">
                    <i class="bi bi-funnel fs-1 texto-suave" aria-hidden="true"></i>
                    <p class="texto-suave mt-2 mb-3">No tenés intercambios en estado @estadoElegido.</p>
                    <a href="@Url.Action("Index", "Intercambio")" class="btn boton-contorno-azul btn-sm">Ver todos</a>
                </div>
            }
        </section>
    }
</div>
