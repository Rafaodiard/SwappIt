@{
    Swappit.Models.ViewModels.DetalleIntercambioViewModel? detalle = ViewBag.detalle;
    bool errorCarga = ViewBag.errorCarga;
}

@if (detalle == null)
{
    <div class="container-xl py-5">
        <div class="tarjeta-blanca angosta p-5 text-center mx-auto">
            <i class="bi @(errorCarga ? "bi-exclamation-triangle" : "bi-search") fs-1 texto-suave" aria-hidden="true"></i>
            <h1 class="letra-serif h2 mt-3">@(errorCarga ? "No pudimos cargar el intercambio" : "Este intercambio no existe")</h1>
            <p class="texto-suave mb-4">
                @(errorCarga ? "Hubo un problema al conectar con la base de datos. Probá de nuevo en un rato."
                             : "Puede que el enlace esté mal o que no seas parte de este intercambio.")
            </p>
            <a href="@Url.Action("Index", "Intercambio")" class="btn boton-bordo">Ir a Mis intercambios</a>
        </div>
    </div>
    return;
}

@{
    Swappit.Models.ViewModels.IntercambioViewModel intercambio = detalle.Intercambio;
    string? fotoOtro = detalle.FotoOtro;
}

<div class="container-xl py-4 py-lg-5">
    <partial name="_Alertas" />

    <a href="@Url.Action("Index", "Intercambio")" class="enlace-flecha mb-3"><i class="bi bi-chevron-left" aria-hidden="true"></i> Mis intercambios</a>

    @if (detalle.PorResponder)
    {
        <!-- ===== Propuesta recibida: Aceptar / Rechazar ===== -->
        <header class="text-center mb-4">
            <h1 class="letra-serif display-5 texto-azul mb-2">Recibiste una propuesta</h1>
            <p class="texto-suave mb-0">@intercambio.OtroNombre te ofrece @detalle.NombresSuyos por @detalle.TuMios @detalle.NombresMios.</p>
        </header>

        <div class="mx-auto ancho-mediano"><partial name="_CajaCambios" /></div>

        <section class="tarjeta-mediana p-4 p-lg-5 mx-auto" aria-label="Propuesta de intercambio">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 pb-4 mb-4 border-bottom">
                <div class="d-flex align-items-center gap-3 sin-ancho-minimo">
                    <span class="foto-redonda-chica" data-iniciales="@intercambio.OtroIniciales">
                        @if (fotoOtro != null) { <img src="@fotoOtro" alt=""> } else { <span aria-hidden="true">@intercambio.OtroIniciales</span> }
                    </span>
                    <div class="sin-ancho-minimo">
                        <p class="fw-bold mb-0 text-truncate">@intercambio.OtroNombre @intercambio.OtroApellido</p>
                        <p class="texto-suave small mb-0 text-truncate">@intercambio.OtroUsuarioYUbicacion</p>
                    </div>
                </div>
                <span class="texto-suave small">Recibida el @intercambio.FechaTexto</span>
            </div>

            <div class="grilla-enfrentada @(detalle.ConCambios ? "alineada-arriba" : "")">
                @{ ViewBag.panel = detalle.PanelSuyo; }
                <partial name="_PanelArticulos" />
                <span class="circulo-crema-mediano" aria-hidden="true"><i class="bi bi-arrow-left-right"></i></span>
                @{ ViewBag.panel = detalle.PanelMio; }
                <partial name="_PanelArticulos" />
            </div>

            @if (detalle.ArticuloComprometido)
            {
                <p class="aviso-crema mt-4 mb-0" role="status"><i class="bi bi-exclamation-circle me-1" aria-hidden="true"></i> Uno de los artículos ya tiene otro intercambio aceptado, así que esta propuesta no se puede aceptar.</p>
            }
            else
            {
                <p class="aviso-crema mt-4 mb-0"><i class="bi bi-info-circle me-1" aria-hidden="true"></i> Si aceptás, coordinan con @intercambio.OtroNombre dónde y cuándo hacer el intercambio.</p>
                @if (detalle.ConfirmarAceptar)
                {
                    <p class="aviso-rosa mt-2 mb-0" role="note"><i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i> @detalle.AvisoRechazos</p>
                }
            }

            <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 pt-4 mt-4 border-top">
                <div class="d-flex flex-wrap gap-3">
                    <a href="@Url.Action("Publico", "Perfil", new { id = intercambio.OtroIdUsuario })" class="fw-semibold text-decoration-none texto-azul">Ver perfil de @intercambio.OtroNombre <i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                    <a href="@Url.Action("Index", "Chat", new { id = intercambio.IdIntercambios })" class="fw-semibold text-decoration-none texto-azul"><i class="bi bi-chat-dots" aria-hidden="true"></i> Preguntarle algo</a>
                </div>
                <div class="d-flex flex-column align-items-sm-end gap-2">
                    <div class="d-flex gap-2 w-100">
                        <form method="post" action="@Url.Action("Rechazar", "Intercambio", new { id = intercambio.IdIntercambios })" asp-antiforgery="true" class="flex-fill">
                            <button type="submit" class="btn boton-contorno-bordo w-100">Rechazar</button>
                        </form>
                        @if (detalle.ConfirmarAceptar)
                        {
                            <button type="button" class="btn boton-bordo flex-fill" data-bs-toggle="modal" data-bs-target="#modal-confirmar-aceptar"
                                    disabled="@detalle.TengoPorResponder" aria-describedby="@(detalle.TengoPorResponder ? "aceptar-bloqueado" : null)">Aceptar intercambio</button>
                        }
                        else
                        {
                            <form method="post" action="@Url.Action("Aceptar", "Intercambio", new { id = intercambio.IdIntercambios })" asp-antiforgery="true" class="flex-fill">
                                <input type="hidden" name="ultimoCambio" value="@detalle.UltimoCambio">
                                <button type="submit" class="btn boton-bordo w-100" disabled="@detalle.AceptarDeshabilitado"
                                        aria-describedby="@(detalle.TengoPorResponder ? "aceptar-bloqueado" : null)">Aceptar intercambio</button>
                            </form>
                        }
                    </div>
                    @if (detalle.TengoPorResponder)
                    {
                        <span class="texto-suave small" id="aceptar-bloqueado">Respondé los cambios de @intercambio.OtroNombreVisible antes de aceptar.</span>
                    }
                </div>
            </div>
        </section>

        <div class="mx-auto ancho-mediano mt-4"><partial name="_HistorialCambios" /></div>

        @if (detalle.ConfirmarAceptar)
        {
            <!-- ===== Pop up: confirmar que se rechazan las otras propuestas ===== -->
            <div class="modal fade ventana-redondeada" id="modal-confirmar-aceptar" tabindex="-1" aria-labelledby="titulo-confirmar-aceptar" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <form class="modal-content" method="post" action="@Url.Action("Aceptar", "Intercambio", new { id = intercambio.IdIntercambios })" asp-antiforgery="true">
                        <input type="hidden" name="ultimoCambio" value="@detalle.UltimoCambio">
                        <div class="modal-header">
                            <h2 class="modal-title letra-serif h3 mb-0" id="titulo-confirmar-aceptar">¿Aceptar este intercambio?</h2>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                        </div>
                        <div class="modal-body d-flex flex-column gap-3">
                            <p class="mb-0">Vas a cambiar @detalle.TuMios <strong>@detalle.NombresMios</strong> por <strong>@detalle.NombresSuyos</strong> de @@@intercambio.OtroUsuario.</p>
                            <p class="aviso-rosa mb-0"><i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i> @detalle.AvisoRechazos @detalle.AvisoNotificados</p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="boton-alto boton-blanco" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="boton-alto boton-azul">Sí, aceptar</button>
                        </div>
                    </form>
                </div>
            </div>
        }
    }
    else
    {
        <!-- ===== Seguimiento del intercambio ===== -->
        <header class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
            <div>
                <h1 class="letra-serif display-5 texto-azul mb-1">Intercambio con @@@intercambio.OtroUsuario</h1>
                <p class="texto-suave mb-0">@detalle.PropuestoPor el @intercambio.FechaTexto</p>
            </div>
            <span class="pastilla @(intercambio.EstadoCss) mt-2">@intercambio.Estado</span>
        </header>

        <div class="row g-4">
            <div class="col-lg-8 d-flex flex-column">
                <partial name="_CajaCambios" />
                <section class="tarjeta-blanca p-4 flex-grow-1" aria-label="Detalle del intercambio">
                    <ol class="pasos-en-linea pb-4 mb-4 border-bottom">
                        <li class="paso-linea relleno-azul">
                            <span class="circulo-contorno" aria-hidden="true"><i class="bi bi-check-lg"></i></span>
                            <span><span class="d-block fw-semibold">Propuesta enviada</span><span class="d-block texto-suave small">@intercambio.FechaCorta</span></span>
                        </li>
                        @if (detalle.Rechazado || detalle.Cancelado)
                        {
                            <li class="paso-linea relleno-bordo">
                                <span class="circulo-contorno" aria-hidden="true"><i class="bi bi-x-lg"></i></span>
                                <span class="fw-semibold">@(detalle.Rechazado ? "Rechazada" : "Cancelado")</span>
                            </li>
                        }
                        else
                        {
                            <li class="paso-linea @(detalle.AceptadoOMas ? "relleno-azul" : "anillo-azul")" aria-current="@(detalle.AceptadoOMas ? null : "step")">
                                <span class="circulo-contorno" aria-hidden="true">@if (detalle.AceptadoOMas) { <i class="bi bi-check-lg" aria-hidden="true"></i> }</span>
                                <span class="fw-semibold">@(detalle.AceptadoOMas ? "Aceptada" : "Esperando respuesta")</span>
                            </li>
                            <li class="paso-linea @(detalle.Realizado ? "relleno-azul" : detalle.AceptadoOMas ? "anillo-azul" : "")" aria-current="@(detalle.EsAceptado ? "step" : null)">
                                <span class="circulo-contorno" aria-hidden="true">@if (detalle.Realizado) { <i class="bi bi-check-lg" aria-hidden="true"></i> }</span>
                                <span class="fw-semibold">Realizado</span>
                            </li>
                        }
                    </ol>

                    <div class="grilla-enfrentada @(detalle.ConCambios ? "alineada-arriba" : "")">
                        @{ ViewBag.panel = detalle.PanelMio; }
                        <partial name="_PanelArticulos" />
                        <span class="circulo-crema-mediano" aria-hidden="true"><i class="bi bi-arrow-left-right"></i></span>
                        @{ ViewBag.panel = detalle.PanelSuyo; }
                        <partial name="_PanelArticulos" />
                    </div>
                </section>
            </div>

            <div class="col-lg-4 d-flex flex-column gap-4">
                <section class="tarjeta-blanca p-4" aria-labelledby="titulo-con-quien">
                    <h2 class="h6 fw-bold mb-3" id="titulo-con-quien">Con quién</h2>
                    <div class="d-flex align-items-center gap-3 mb-3 sin-ancho-minimo">
                        <span class="foto-redonda-chica" data-iniciales="@intercambio.OtroIniciales">
                            @if (fotoOtro != null) { <img src="@fotoOtro" alt=""> } else { <span aria-hidden="true">@intercambio.OtroIniciales</span> }
                        </span>
                        <div class="sin-ancho-minimo">
                            <p class="fw-bold mb-0 text-truncate">@intercambio.OtroNombre @intercambio.OtroApellido</p>
                            <p class="texto-suave small mb-0 text-truncate">@intercambio.OtroUsuarioYUbicacion</p>
                        </div>
                    </div>
                    <a href="@Url.Action("Publico", "Perfil", new { id = intercambio.OtroIdUsuario })" class="fw-semibold text-decoration-none texto-azul small">Ver perfil <i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                </section>

                <partial name="_HistorialCambios" />

                <section class="tarjeta-blanca p-4" aria-labelledby="titulo-proximos-pasos">
                    <h2 class="h6 fw-bold mb-3" id="titulo-proximos-pasos">Próximos pasos</h2>
                    @if (detalle.EsPendiente)
                    {
                        <p class="texto-suave small mb-3">Esperando que @intercambio.OtroNombre responda tu propuesta. Si te escribe, vas a ver el mensaje en el chat; si la acepta, van a poder coordinar dónde y cuándo hacer el intercambio.</p>
                        <div class="d-flex flex-column gap-2">
                            <button type="button" class="btn boton-contorno-bordo" data-bs-toggle="modal" data-bs-target="#modal-cancelar">Cancelar propuesta</button>
                        </div>
                    }
                    else if (detalle.EsAceptado)
                    {
                        <p class="texto-suave small mb-3">Coordiná con @intercambio.OtroNombre el lugar y el horario. Cuando hayan hecho el intercambio, marcalo como realizado.</p>
                        <div class="d-flex flex-column gap-2">
                            <a href="@Url.Action("Index", "Chat", new { id = intercambio.IdIntercambios })" class="btn boton-bordo"><i class="bi bi-chat-dots me-1" aria-hidden="true"></i> Ir al chat</a>
                            <form method="post" action="@Url.Action("MarcarRealizado", "Intercambio", new { id = intercambio.IdIntercambios })" asp-antiforgery="true">
                                <button type="submit" class="btn boton-contorno-azul w-100" disabled="@detalle.HayPendientes"
                                        aria-describedby="@(detalle.HayPendientes ? "realizado-bloqueado" : null)">Marcar como realizado</button>
                            </form>
                            @if (detalle.HayPendientes)
                            {
                                <span class="texto-suave small" id="realizado-bloqueado">Hay cambios sin responder. Respondelos o cancelalos antes de marcarlo como realizado.</span>
                            }
                            <button type="button" class="btn boton-contorno-bordo" data-bs-toggle="modal" data-bs-target="#modal-cancelar">Cancelar intercambio</button>
                        </div>
                    }
                    else if (detalle.Realizado)
                    {
                        <p class="texto-suave small mb-0"><i class="bi bi-check-circle-fill texto-azul me-1" aria-hidden="true"></i> ¡Listo! Este intercambio ya se hizo.</p>
                    }
                    else if (detalle.Cancelado)
                    {
                        <p class="texto-suave small mb-3">Este intercambio se canceló. El chat queda para leer.</p>
                        <a href="@Url.Action("Buscar", "Articulos")" class="btn boton-contorno-azul w-100">Buscar otros artículos</a>
                    }
                    else
                    {
                        <p class="texto-suave small mb-3">@detalle.TextoRechazo</p>
                        <a href="@Url.Action("Buscar", "Articulos")" class="btn boton-contorno-azul w-100">Buscar otros artículos</a>
                    }
                </section>
            </div>
        </div>

        @if (detalle.PuedeCancelar)
        {
            <!-- ===== Pop up: confirmar la cancelación ===== -->
            <div class="modal fade ventana-redondeada" id="modal-cancelar" tabindex="-1" aria-labelledby="titulo-cancelar" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <form class="modal-content" method="post" action="@Url.Action("Cancelar", "Intercambio", new { id = intercambio.IdIntercambios })" asp-antiforgery="true">
                        <div class="modal-header">
                            <h2 class="modal-title letra-serif h3 mb-0" id="titulo-cancelar">@(detalle.EsPendiente ? "¿Cancelar tu propuesta?" : "¿Cancelar este intercambio?")</h2>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                        </div>
                        <div class="modal-body d-flex flex-column gap-3">
                            <p class="mb-0">Ya no vas a cambiar @detalle.TuMios <strong>@detalle.NombresMios</strong> por <strong>@detalle.NombresSuyos</strong> de @@@intercambio.OtroUsuario.</p>
                            <p class="aviso-rosa mb-0"><i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i> No se puede deshacer. A @intercambio.OtroNombre le va a llegar una notificación@(detalle.EsPendiente ? "" : " y los artículos vuelven a aparecer en el catálogo").</p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="boton-alto boton-blanco" data-bs-dismiss="modal">Volver</button>
                            <button type="submit" class="boton-alto boton-azul">Sí, cancelar</button>
                        </div>
                    </form>
                </div>
            </div>
        }
    }

    <partial name="_ModalesCambios" />
</div>

@section Scripts {
    <script src="~/js/articulo.js" asp-append-version="true"></script>
}
