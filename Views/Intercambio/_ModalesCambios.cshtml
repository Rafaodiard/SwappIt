@{
    Swappit.Models.ViewModels.DetalleIntercambioViewModel detalle = ViewBag.detalle;
}
@if (detalle.MostrarAgregar)
{
    <!-- ===== Pop up: agregar artículos propios ===== -->
    <div class="modal fade ventana-redondeada" id="modal-agregar" tabindex="-1" aria-labelledby="titulo-agregar" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <form class="modal-content" method="post" action="@Url.Action("AgregarArticulos", "Intercambio", new { id = detalle.Intercambio.IdIntercambios })" asp-antiforgery="true"
                  data-proponer data-max-ofrecidos="@detalle.LugarMio">
                <div class="modal-header">
                    <h2 class="modal-title letra-serif h3 mb-0" id="titulo-agregar">Agregar de tus artículos</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body d-flex flex-column gap-3">
                    <p class="aviso-crema mb-0"><i class="bi bi-info-circle me-1" aria-hidden="true"></i> Se suman enseguida. A @detalle.Intercambio.OtroNombre le llega un aviso.</p>
                    <fieldset class="d-flex flex-column gap-2" aria-describedby="agregar-contador">
                        <legend class="leyenda-chica">@detalle.LeyendaAgregar</legend>
                        @{
                            ViewBag.opcionTipo = "checkbox";
                            ViewBag.opcionNombre = "idsArticulos";
                            ViewBag.opcionMarcada = false;
                            ViewBag.opcionRequerida = false;
                        }
                        @foreach (var articulo in detalle.ParaAgregar)
                        {
                            ViewBag.opcion = articulo;
                            <partial name="_OpcionArticulo" />
                        }
                    </fieldset>
                    <p class="texto-mini mb-0" id="agregar-contador" data-proponer-contador aria-live="polite">Elegí qué querés sumar.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="boton-alto boton-blanco" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="boton-alto boton-azul">Agregar</button>
                </div>
            </form>
        </div>
    </div>
}
@if (detalle.MostrarPedir)
{
    <!-- ===== Pop up: pedirle un artículo al otro ===== -->
    <div class="modal fade ventana-redondeada" id="modal-pedir" tabindex="-1" aria-labelledby="titulo-pedir" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <form class="modal-content" method="post" action="@Url.Action("PedirArticulo", "Intercambio", new { id = detalle.Intercambio.IdIntercambios })" asp-antiforgery="true">
                <div class="modal-header">
                    <h2 class="modal-title letra-serif h3 mb-0" id="titulo-pedir">Pedirle un artículo a @detalle.Intercambio.OtroNombre</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body d-flex flex-column gap-3">
                    <p class="aviso-crema mb-0"><i class="bi bi-info-circle me-1" aria-hidden="true"></i> @detalle.Intercambio.OtroNombre tiene que aceptarlo para que se sume.</p>
                    <fieldset class="d-flex flex-column gap-2">
                        <legend class="leyenda-chica">Elegí un artículo</legend>
                        @{
                            ViewBag.opcionTipo = "radio";
                            ViewBag.opcionNombre = "idArticulo";
                            ViewBag.opcionMarcada = false;
                            ViewBag.opcionRequerida = true;
                        }
                        @foreach (var articulo in detalle.ParaPedir)
                        {
                            ViewBag.opcion = articulo;
                            <partial name="_OpcionArticulo" />
                        }
                    </fieldset>
                </div>
                <div class="modal-footer">
                    <button type="button" class="boton-alto boton-blanco" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="boton-alto boton-azul">Pedir</button>
                </div>
            </form>
        </div>
    </div>
}
