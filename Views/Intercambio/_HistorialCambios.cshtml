@{
    Swappit.Models.ViewModels.DetalleIntercambioViewModel detalle = ViewBag.detalle;
}
@if (detalle.Historial.Count > 0)
{
    <section class="tarjeta-blanca p-4" aria-labelledby="titulo-historial-cambios">
        <h2 class="h6 fw-bold mb-3" id="titulo-historial-cambios">Últimos cambios</h2>
        <ol class="list-unstyled mb-0 lista-con-lineas">
            @foreach (var e in detalle.Historial)
            {
                <li><span class="fw-semibold">@e.Quien</span> @e.Texto <span class="texto-suave">· @e.Cuando</span></li>
            }
        </ol>
    </section>
}
