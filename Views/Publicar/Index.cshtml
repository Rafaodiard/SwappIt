@using Swappit.Models.ViewModels
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    bool esEdicion = ViewBag.esEdicion == true;
    ViewData["Title"] = esEdicion ? "Editar objeto" : "Publicar objeto";
    PublicarArticuloViewModel publicar = ViewBag.publicar;
    List<SelectListItem> categorias = ViewBag.categorias;
    List<Swappit.Models.EstadosArticulos> estados = ViewBag.estados;
    bool limiteAlcanzado = ViewBag.limiteAlcanzado;
    Dictionary<string, string> requeridos = ViewBag.requeridos;
    string? categoriaElegida = ViewBag.categoriaElegida;
    string? categoriaACambioElegida = ViewBag.categoriaACambioElegida;
    int maxFotos = ViewBag.maxFotos;
    int maxFotoMB = ViewBag.maxFotoMB;
    PlanViewModel? plan = ViewBag.plan;
    int maxDescripcion = ViewBag.maxDescripcion;
    List<string> fotosExistentes = publicar.FotosExistentes ?? new List<string>();
}

<section class="sw-publicar">
    <div class="sw-publicar-wrap">

        <header class="sw-publicar-encabezado">
            <h1 class="sw-auth-titulo">@(esEdicion ? "Editá tu objeto" : "Publicá tu objeto")</h1>
            <p class="sw-auth-subtitulo">@(esEdicion ? "Cambiar fotos, descripción o lo que buscás a cambio" : "Subí fotos, contá cómo está y elegí qué te gustaría recibir a cambio")</p>
        </header>

        <form class="sw-publicar-card" method="post" enctype="multipart/form-data"
              action="@Url.Action(esEdicion ? "Editar" : "Index", "Publicar")" asp-antiforgery="true" novalidate>
            @if (esEdicion)
            {
                <input type="hidden" name="IdArticulo" value="@publicar.IdArticulo">
            }

            <!-- ===== Columna izquierda: fotos ===== -->
            <div class="sw-publicar-fotos">
                <div class="sw-campo">
                    <span class="sw-label" id="etiqueta-fotos">Fotos del objeto</span>
                    <span class="sw-ayuda">La primera foto va a ser la portada de tu publicación.</span>
                </div>

                <div class="sw-zona-carga" id="zona-carga" role="button" tabindex="0" aria-labelledby="etiqueta-fotos">
                    <span class="sw-zona-carga-icono"><i class="bi bi-camera" aria-hidden="true"></i></span>
                    <p class="sw-zona-carga-titulo">Arrastrá tus fotos acá</p>
                    <p class="sw-zona-carga-ayuda">o hacé clic para buscarlas en tu dispositivo</p>
                    <button type="button" class="sw-btn sw-btn-contorno" id="boton-subir-fotos" tabindex="-1">Subir fotos</button>
                </div>
                <input id="Fotos" name="Fotos" type="file" accept="image/jpeg,image/png" multiple hidden
                       data-max-fotos="@maxFotos" data-max-mb="@maxFotoMB">

                <div class="sw-miniaturas" id="miniaturas">
                    <button type="button" class="sw-miniatura" aria-label="Agregar foto">+</button>
                    <button type="button" class="sw-miniatura" aria-label="Agregar foto">+</button>
                    <button type="button" class="sw-miniatura" aria-label="Agregar foto">+</button>
                    <button type="button" class="sw-miniatura" aria-label="Agregar foto">+</button>
                </div>

                <p class="sw-nota">Hasta @maxFotos fotos · JPG o PNG · máx. @maxFotoMB MB cada una</p>
                @Html.ValidationMessage("Fotos", new { @class = "sw-error" })
                <p class="sw-error" id="aviso-fotos" role="alert"></p>

                @if (esEdicion && fotosExistentes.Count > 0)
                {
                    <div class="sw-miniaturas mb-2" aria-label="Fotos actuales">
                        @foreach (string foto in fotosExistentes)
                        {
                            <label class="sw-miniatura sw-miniatura--llena position-relative">
                                <img src="@foto" alt="Foto actual del artículo">
                                <input type="checkbox" name="FotosEliminar" value="@foto" class="position-absolute top-0 end-0 m-2"
                                       aria-label="Eliminar esta foto">
                            </label>
                        }
                    </div>
                    <p class="sw-ayuda">Marcá las fotos que querés eliminar.</p>
                }
            </div>

            <!-- ===== Columna derecha: datos ===== -->
            <div class="sw-publicar-datos">
                @Html.ValidationSummary(true, "", new { @class = "sw-error-resumen", role = "alert" })
                @if (limiteAlcanzado)
                {
                    <p class="sw-aviso-rechazos mb-0" role="alert">
                        <i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>
                        @if (plan != null)
                        {
                            <text>Con el plan @plan.Nombre podés tener hasta @plan.MaxArticulos objetos publicados, contando los que están en un intercambio pendiente o aceptado.</text>
                        }
                        else
                        {
                            <text>No pudimos revisar cuántos objetos podés publicar.</text>
                        }
                        Cuando un intercambio se complete, vas a poder publicar otro.
                        <a href="@Url.Action("Index", "Intercambio")" class="fw-semibold text-reset">Ver mis intercambios</a> ·
                        <a href="@Url.Action("Index", "Planes")" class="fw-semibold text-reset">Ver planes</a>
                    </p>
                }

                <div class="sw-campo">
                    <label class="sw-label" for="Titulo">Título</label>
                    <input class="sw-input" id="Titulo" name="Titulo" value="@publicar.Titulo" data-requerido="@requeridos["Titulo"]" placeholder="Ej: Silla de madera estilo nórdico" maxlength="50">
                    @Html.ValidationMessage("Titulo", new { @class = "sw-error" })
                </div>

                <div class="sw-fila">
                    <div class="sw-campo">
                        <label class="sw-label" for="IdCategorias">Categoría</label>
                        <select class="sw-input sw-select" id="IdCategorias" name="IdCategorias" required data-requerido="@requeridos["IdCategorias"]">
                            <option value="" disabled selected="@(publicar.IdCategorias == null)">Elegí una categoría</option>
                            @foreach (var c in categorias)
                            {
                                <option value="@c.Value" selected="@(c.Value == categoriaElegida)">@c.Text</option>
                            }
                        </select>
                        @Html.ValidationMessage("IdCategorias", new { @class = "sw-error" })
                    </div>
                    <div class="sw-campo">
                        <label class="sw-label" for="Ubicacion">Ubicación</label>
                        <input class="sw-input" id="Ubicacion" name="Ubicacion" value="@publicar.Ubicacion" data-requerido="@requeridos["Ubicacion"]" placeholder="Palermo, CABA" maxlength="100">
                        @Html.ValidationMessage("Ubicacion", new { @class = "sw-error" })
                    </div>
                </div>

                <div class="sw-campo sw-campo-estado">
                    <span class="sw-label" id="etiqueta-estado">Estado del objeto</span>
                    <div class="sw-estados" role="radiogroup" aria-labelledby="etiqueta-estado" data-nombre="IdEstado" data-requerido="@requeridos["IdEstado"]">
                        @foreach (var estado in estados)
                        {
                            <input type="radio" class="sw-estado-radio" id="Estado_@(estado.IdEstadosArticulos)" name="IdEstado" value="@estado.IdEstadosArticulos" checked="@(publicar.IdEstado == estado.IdEstadosArticulos)">
                            <label class="sw-estado" for="Estado_@(estado.IdEstadosArticulos)">@estado.Nombre</label>
                        }
                    </div>
                    @Html.ValidationMessage("IdEstado", new { @class = "sw-error" })
                </div>

                <div class="sw-campo">
                    <label class="sw-label" for="Descripcion">Descripción</label>
                    <textarea class="sw-input sw-textarea" id="Descripcion" name="Descripcion" rows="5" data-requerido="@requeridos["Descripcion"]" maxlength="@maxDescripcion" placeholder="Contá medidas, antigüedad, detalles o marcas de uso…">@publicar.Descripcion</textarea>
                    <span class="sw-contador" id="contador-descripcion" aria-live="polite">0/@maxDescripcion</span>
                    @Html.ValidationMessage("Descripcion", new { @class = "sw-error" })
                </div>

                <div class="sw-campo">
                    <label class="sw-label" for="IdCategoriaACambio">¿Qué te gustaría recibir a cambio?</label>
                    <span class="sw-ayuda" id="ayuda-a-cambio">Elegí una categoría o dejalo abierto a propuestas.</span>
                    <select class="sw-input sw-select" id="IdCategoriaACambio" name="IdCategoriaACambio" aria-describedby="ayuda-a-cambio">
                        <option value="" selected="@(publicar.IdCategoriaACambio == null)">Abierto a propuestas</option>
                        @foreach (var c in categorias)
                        {
                            <option value="@c.Value" selected="@(c.Value == categoriaACambioElegida)">@c.Text</option>
                        }
                    </select>
                    @Html.ValidationMessage("IdCategoriaACambio", new { @class = "sw-error" })
                </div>

                <hr class="sw-divisor">

                <div class="sw-publicar-acciones">
                    <a href="@(esEdicion ? Url.Action("Detalle", "Articulos", new { id = publicar.IdArticulo }) : Url.Action("Index", "Home"))" class="sw-btn sw-btn-contorno">Cancelar</a>
                    <button type="submit" class="sw-btn sw-btn-solido" disabled="@limiteAlcanzado">@(esEdicion ? "Guardar cambios" : "Publicar objeto")</button>
                </div>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/publicar.js" asp-append-version="true"></script>
}
