@using Swappit.Models.ViewModels
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Publicar objeto";
    // Lo cargado en el formulario (vacío la primera vez; con los datos del usuario si el POST volvió con errores).
    PublicarArticuloViewModel publicar = ViewBag.publicar;
    List<SelectListItem> categorias = ViewBag.categorias;
    // Filas de la tabla EstadosArticulos (PublicarController.ObtenerEstados).
    List<Swappit.Models.EstadosArticulos> estados = ViewBag.estados;
}

@functions {
    // Clase que pone el input en rojo si el campo volvió del controller con error (como hacía asp-for).
    string ClaseError(string campo) => ViewData.ModelState[campo]?.Errors.Count > 0 ? "input-validation-error" : "";
}

<section class="sw-publicar">
    <div class="sw-publicar-wrap">

        <header class="sw-publicar-encabezado">
            <h1 class="sw-auth-titulo">Publicá tu objeto</h1>
            <p class="sw-auth-subtitulo">Subí fotos, contá cómo está y elegí qué te gustaría recibir a cambio</p>
        </header>

        <form class="sw-publicar-card" method="post" enctype="multipart/form-data" action="@Url.Action("Index", "Publicar")" asp-antiforgery="true" novalidate>

            <!-- ===== Columna izquierda: fotos ===== -->
            <div class="sw-publicar-fotos">
                <div class="sw-campo">
                    <span class="sw-label" id="etiqueta-fotos">Fotos del objeto</span>
                    <span class="sw-ayuda">La primera foto va a ser la portada de tu publicación.</span>
                </div>

                <!-- Zona de carga: clic o arrastrar. El input real está oculto. -->
                <div class="sw-zona-carga" id="zona-carga" role="button" tabindex="0" aria-labelledby="etiqueta-fotos">
                    <span class="sw-zona-carga-icono"><i class="bi bi-camera" aria-hidden="true"></i></span>
                    <p class="sw-zona-carga-titulo">Arrastrá tus fotos acá</p>
                    <p class="sw-zona-carga-ayuda">o hacé clic para buscarlas en tu dispositivo</p>
                    <button type="button" class="sw-btn sw-btn-contorno" id="boton-subir-fotos" tabindex="-1">Subir fotos</button>
                </div>
                <input id="Fotos" name="Fotos" type="file" accept="image/jpeg,image/png" multiple hidden
                       data-max-fotos="@PublicarArticuloViewModel.MaxFotos" data-max-mb="@PublicarArticuloViewModel.MaxFotoMB">

                <!-- Miniaturas: 4 espacios vacíos; publicar.js las completa con las fotos elegidas -->
                <div class="sw-miniaturas" id="miniaturas">
                    <button type="button" class="sw-miniatura" aria-label="Agregar foto">+</button>
                    <button type="button" class="sw-miniatura" aria-label="Agregar foto">+</button>
                    <button type="button" class="sw-miniatura" aria-label="Agregar foto">+</button>
                    <button type="button" class="sw-miniatura" aria-label="Agregar foto">+</button>
                </div>

                <p class="sw-nota">Hasta @PublicarArticuloViewModel.MaxFotos fotos · JPG o PNG · máx. @PublicarArticuloViewModel.MaxFotoMB MB cada una</p>
                @Html.ValidationMessage("Fotos", new { @class = "sw-error" })
                <!-- Aviso de publicar.js si se eligen fotos que no se aceptan -->
                <p class="sw-error" id="aviso-fotos" role="alert"></p>
            </div>

            <!-- ===== Columna derecha: datos ===== -->
            <div class="sw-publicar-datos">
                @Html.ValidationSummary(true, "", new { @class = "sw-error-resumen", role = "alert" })

                <div class="sw-campo">
                    <label class="sw-label" for="Titulo">Título</label>
                    <input class="sw-input @ClaseError("Titulo")" id="Titulo" name="Titulo" value="@publicar.Titulo" placeholder="Ej: Silla de madera estilo nórdico" maxlength="50">
                    @Html.ValidationMessage("Titulo", new { @class = "sw-error" })
                </div>

                <div class="sw-fila">
                    <div class="sw-campo">
                        <label class="sw-label" for="IdCategorias">Categoría</label>
                        <select class="sw-input sw-select @ClaseError("IdCategorias")" id="IdCategorias" name="IdCategorias" required>
                            <option value="" disabled selected="@(publicar.IdCategorias == null)">Elegí una categoría</option>
                            @foreach (var c in categorias)
                            {
                                <option value="@c.Value" selected="@(c.Value == publicar.IdCategorias?.ToString())">@c.Text</option>
                            }
                        </select>
                        @Html.ValidationMessage("IdCategorias", new { @class = "sw-error" })
                    </div>
                    <div class="sw-campo">
                        <label class="sw-label" for="Ubicacion">Ubicación</label>
                        <input class="sw-input @ClaseError("Ubicacion")" id="Ubicacion" name="Ubicacion" value="@publicar.Ubicacion" placeholder="Palermo, CABA" maxlength="100">
                        @Html.ValidationMessage("Ubicacion", new { @class = "sw-error" })
                    </div>
                </div>

                <div class="sw-campo sw-campo-estado">
                    <span class="sw-label" id="etiqueta-estado">Estado del objeto</span>
                    <div class="sw-estados" role="radiogroup" aria-labelledby="etiqueta-estado">
                        @foreach (var estado in estados)
                        {
                            var idEstado = "Estado_" + estado.IdEstadosArticulos;
                            <input type="radio" class="sw-estado-radio" id="@idEstado" name="IdEstado" value="@estado.IdEstadosArticulos" checked="@(publicar.IdEstado == estado.IdEstadosArticulos)">
                            <label class="sw-estado" for="@idEstado">@estado.Nombre</label>
                        }
                    </div>
                    @Html.ValidationMessage("IdEstado", new { @class = "sw-error" })
                </div>

                <div class="sw-campo">
                    <label class="sw-label" for="Descripcion">Descripción</label>
                    <textarea class="sw-input sw-textarea @ClaseError("Descripcion")" id="Descripcion" name="Descripcion" rows="5" maxlength="@PublicarArticuloViewModel.MaxDescripcion" placeholder="Contá medidas, antigüedad, detalles o marcas de uso…">@publicar.Descripcion</textarea>
                    <span class="sw-contador" id="contador-descripcion" aria-live="polite">0/@PublicarArticuloViewModel.MaxDescripcion</span>
                    @Html.ValidationMessage("Descripcion", new { @class = "sw-error" })
                </div>

                <div class="sw-campo">
                    <label class="sw-label" for="ACambio">¿Qué te gustaría recibir a cambio?</label>
                    <span class="sw-ayuda">Podés poner varias opciones o dejarlo abierto a propuestas.</span>
                    <input class="sw-input @ClaseError("ACambio")" id="ACambio" name="ACambio" value="@publicar.ACambio" placeholder="Ej: una lámpara, libros, plantas…" maxlength="100">
                    @Html.ValidationMessage("ACambio", new { @class = "sw-error" })
                </div>

                <hr class="sw-divisor">

                <div class="sw-publicar-acciones">
                    <a href="@Url.Action("Index", "Home")" class="sw-btn sw-btn-contorno">Cancelar</a>
                    <button type="submit" class="sw-btn sw-btn-solido">Publicar objeto</button>
                </div>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/publicar.js" asp-append-version="true"></script>
}
