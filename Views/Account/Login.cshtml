@{
    ViewData["Title"] = "Iniciar sesión";
    // Lo que se cargó en el formulario, si el controller lo devolvió (POST con error). La contraseña no se vuelve a mostrar.
    Swappit.Models.ViewModels.LoginViewModel? login = ViewBag.login;
}

@functions {
    // Clase que pone el input en rojo si el campo volvió del controller con error (como hacía asp-for).
    string ClaseError(string campo) => ViewData.ModelState[campo]?.Errors.Count > 0 ? "input-validation-error" : "";
}

@*
    Pantalla derivada del diseño de "Registrarse" (no hay un frame de login
    en alta fidelidad): misma tarjeta, tipografías y componentes del UI Kit.
*@
<section class="sw-auth">
    <div class="sw-auth-card sw-auth-card--angosta">
        <header class="sw-auth-encabezado">
            <h1 class="sw-auth-titulo">Iniciá sesión</h1>
            <p class="sw-auth-subtitulo">Ingresá para seguir intercambiando</p>
        </header>

        <form class="sw-form" method="post" asp-controller="Account" asp-action="Login" novalidate>
            <!-- Errores generales (ej: "Email o contraseña incorrectos") -->
            @Html.ValidationSummary(true, "", new { @class = "sw-error-resumen", role = "alert" })
            @if (ViewBag.Error != null)
            {
                <p class="sw-error-resumen" role="alert">@ViewBag.Error</p>
            }

            <div class="sw-campo">
                <label class="sw-label" for="Mail">Email</label>
                <input class="sw-input @ClaseError("Mail")" id="Mail" name="Mail" value="@login?.Mail" type="email" placeholder="tunombre@@email.com" autocomplete="email" maxlength="50">
                @Html.ValidationMessage("Mail", new { @class = "sw-error" })
            </div>

            <div class="sw-campo">
                <label class="sw-label" for="Contrasena">Contraseña</label>
                <input class="sw-input @ClaseError("Contrasena")" id="Contrasena" name="Contrasena" type="password" placeholder="Tu contraseña" autocomplete="current-password" maxlength="50">
                @Html.ValidationMessage("Contrasena", new { @class = "sw-error" })
                <a href="#" class="sw-link sw-link-chico sw-campo-extra">¿Olvidaste tu contraseña?</a>
            </div>

            <div class="sw-form-acciones">
                <button type="submit" class="sw-btn sw-btn-solido sw-btn-bloque">Iniciar sesión</button>
            </div>
        </form>

        <p class="sw-auth-pie">
            <span>¿Todavía no tenés cuenta?</span>
            <a asp-controller="Account" asp-action="Registro" class="sw-link">Registrate</a>
        </p>
    </div>
</section>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
}
