@{
    ViewData["Title"] = "Iniciar sesión";
    Swappit.Models.ViewModels.LoginViewModel? login = ViewBag.login;
}

<section class="franja-crema">
    <div class="tarjeta-grande angosta">
        <header class="cabecera-centrada">
            <h1 class="titulo-serif-enorme">Iniciá sesión</h1>
            <p class="subtitulo-suave">Ingresá para seguir intercambiando</p>
        </header>

        <form class="formulario-espaciado" method="post" action="@Url.Action("Login", "Account")" asp-antiforgery="true" novalidate>
            @Html.ValidationSummary(true, "", new { @class = "aviso-rojo", role = "alert" })
            @if (ViewBag.Error != null)
            {
                <p class="aviso-rojo" role="alert">@ViewBag.Error</p>
            }

            <div class="columna-campo">
                <label class="etiqueta-negrita" for="Mail">Email</label>
                <input class="caja-texto" id="Mail" name="Mail" value="@login?.Mail" type="email" placeholder="tunombre@@email.com" autocomplete="email" maxlength="50">
                @Html.ValidationMessage("Mail", new { @class = "texto-rojo" })
            </div>

            <div class="columna-campo">
                <label class="etiqueta-negrita" for="Contrasena">Contraseña</label>
                <input class="caja-texto" id="Contrasena" name="Contrasena" type="password" placeholder="Tu contraseña" autocomplete="current-password" maxlength="50">
                @Html.ValidationMessage("Contrasena", new { @class = "texto-rojo" })
            </div>

            <div class="separado-arriba">
                <button type="submit" class="boton-alto boton-azul ancho-completo">Iniciar sesión</button>
            </div>
        </form>

        <p class="pie-centrado">
            <span>¿Todavía no tenés cuenta?</span>
            <a href="@Url.Action("Registro", "Account")" class="enlace-azul">Registrate</a>
        </p>
    </div>
</section>
