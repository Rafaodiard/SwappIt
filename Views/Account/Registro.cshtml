@{
    ViewData["Title"] = "Registrarse";
    // Lo que se cargó en el formulario, si el controller lo devolvió (POST con error). La contraseña no se vuelve a mostrar.
    Swappit.Models.ViewModels.RegistroViewModel? registro = ViewBag.registro;
}

@functions {
    // Clase que pone el input en rojo si el campo volvió del controller con error (como hacía asp-for).
    string ClaseError(string campo) => ViewData.ModelState[campo]?.Errors.Count > 0 ? "input-validation-error" : "";
}

<section class="sw-auth">
    <div class="sw-auth-card">
        <header class="sw-auth-encabezado">
            <h1 class="sw-auth-titulo">Registrate</h1>
            <p class="sw-auth-subtitulo">Creá tu cuenta y empezá a intercambiar</p>
        </header>

        <form class="sw-form" method="post" action="@Url.Action("Registro", "Account")" asp-antiforgery="true" novalidate>
            @Html.ValidationSummary(true, "", new { @class = "sw-error-resumen", role = "alert" })
            @if (ViewBag.Error != null)
            {
                <p class="sw-error-resumen" role="alert">@ViewBag.Error</p>
            }

            <div class="sw-fila">
                <div class="sw-campo">
                    <label class="sw-label" for="Nombre">Nombre</label>
                    <input class="sw-input @ClaseError("Nombre")" id="Nombre" name="Nombre" value="@registro?.Nombre" placeholder="Martina" autocomplete="given-name" maxlength="50">
                    @Html.ValidationMessage("Nombre", new { @class = "sw-error" })
                </div>
                <div class="sw-campo">
                    <label class="sw-label" for="Apellido">Apellido</label>
                    <input class="sw-input @ClaseError("Apellido")" id="Apellido" name="Apellido" value="@registro?.Apellido" placeholder="González" autocomplete="family-name" maxlength="50">
                    @Html.ValidationMessage("Apellido", new { @class = "sw-error" })
                </div>
            </div>

            <div class="sw-campo">
                <label class="sw-label" for="Mail">Email</label>
                <input class="sw-input @ClaseError("Mail")" id="Mail" name="Mail" value="@registro?.Mail" type="email" placeholder="tunombre@@email.com" autocomplete="email" maxlength="50">
                @Html.ValidationMessage("Mail", new { @class = "sw-error" })
            </div>

            <div class="sw-campo">
                <label class="sw-label" for="Contrasena">Contraseña</label>
                <input class="sw-input @ClaseError("Contrasena")" id="Contrasena" name="Contrasena" type="password" placeholder="Mínimo 8 caracteres" autocomplete="new-password" maxlength="50">
                @Html.ValidationMessage("Contrasena", new { @class = "sw-error" })
            </div>

            <div class="sw-campo">
                <label class="sw-label" for="password2">Repetir contraseña</label>
                <input class="sw-input" id="password2" name="password2" type="password" placeholder="Repetí tu contraseña" autocomplete="new-password" maxlength="50">
            </div>

            <div class="sw-fila">
                <div class="sw-campo">
                    <label class="sw-label" for="FechaNacimiento">Fecha de nacimiento</label>
                    <div class="sw-input-icono">
                        <i class="bi bi-calendar3" aria-hidden="true"></i>
                        <input class="sw-input @ClaseError("FechaNacimiento")" id="FechaNacimiento" name="FechaNacimiento" value="@registro?.FechaNacimiento?.ToString("yyyy-MM-dd")" type="date" autocomplete="bday">
                    </div>
                    @Html.ValidationMessage("FechaNacimiento", new { @class = "sw-error" })
                </div>
                <div class="sw-campo">
                    <label class="sw-label" for="Telefono">Número de teléfono</label>
                    <input class="sw-input @ClaseError("Telefono")" id="Telefono" name="Telefono" value="@registro?.Telefono" type="tel" placeholder="+54 9 11 0000-0000" autocomplete="tel">
                    @Html.ValidationMessage("Telefono", new { @class = "sw-error" })
                </div>
            </div>

            <div class="sw-form-acciones">
                <button type="submit" class="sw-btn sw-btn-solido sw-btn-bloque">Crear cuenta</button>
            </div>
        </form>

        <p class="sw-auth-pie">
            <span>¿Ya tenés cuenta?</span>
            <a href="@Url.Action("Index", "Account")" class="sw-link">Iniciar sesión</a>
        </p>
    </div>
</section>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
}
