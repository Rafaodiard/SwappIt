@{
    ViewData["Title"] = "Cambiar contraseña";
}

<section class="franja-crema">
    <div class="tarjeta-grande angosta">
        <header class="cabecera-centrada">
            <h1 class="titulo-serif-enorme">Cambiá tu contraseña</h1>
            <p class="subtitulo-suave">Ingresá tu contraseña actual y elegí una nueva</p>
        </header>

        <form class="formulario-espaciado" method="post" action="@Url.Action("CambiarContrasena", "Account")" asp-antiforgery="true" data-cambiar-contrasena>
            <p class="aviso-rojo" role="alert" data-contrasena-error></p>
            <p class="text-success small mb-0" role="status" data-contrasena-exito hidden></p>

            <div class="columna-campo">
                <label class="etiqueta-negrita" for="contrasenaActual">Contraseña actual</label>
                <input class="caja-texto" id="contrasenaActual" name="contrasenaActual" type="password" autocomplete="current-password" maxlength="50" required>
            </div>

            <div class="columna-campo">
                <label class="etiqueta-negrita" for="contrasenaNueva">Nueva contraseña</label>
                <input class="caja-texto" id="contrasenaNueva" name="contrasenaNueva" type="password" autocomplete="new-password" maxlength="50" required>
            </div>

            <div class="columna-campo">
                <label class="etiqueta-negrita" for="confirmarContrasena">Repetir nueva contraseña</label>
                <input class="caja-texto" id="confirmarContrasena" name="confirmarContrasena" type="password" autocomplete="new-password" maxlength="50" required>
            </div>

            <div class="separado-arriba">
                <button type="submit" class="boton-alto boton-azul ancho-completo">Guardar</button>
            </div>
        </form>

        <p class="pie-centrado">
            <a href="@Url.Action("Index", "Perfil")" class="enlace-azul">Volver a mi perfil</a>
        </p>
    </div>
</section>

@section Scripts {
    <script src="~/js/contrasena.js" asp-append-version="true"></script>
}
