@{
    ViewData["Title"] = "Cambiar contraseña";
}

<section class="sw-auth">
    <div class="sw-auth-card sw-auth-card--angosta">
        <header class="sw-auth-encabezado">
            <h1 class="sw-auth-titulo">Cambiá tu contraseña</h1>
            <p class="sw-auth-subtitulo">Ingresá tu contraseña actual y elegí una nueva</p>
        </header>

        <form class="sw-form" method="post" asp-controller="Account" asp-action="CambiarContrasena">
            @if (ViewBag.Error != null)
            {
                <p class="sw-error-resumen" role="alert">@ViewBag.Error</p>
            }
            @if (ViewBag.Message != null)
            {
                <p class="text-success small mb-0" role="status">@ViewBag.Message</p>
            }

            <div class="sw-campo">
                <label class="sw-label" for="contrasenaActual">Contraseña actual</label>
                <input class="sw-input" id="contrasenaActual" name="contrasenaActual" type="password" autocomplete="current-password" maxlength="50" required>
            </div>

            <div class="sw-campo">
                <label class="sw-label" for="contrasenaNueva">Nueva contraseña</label>
                <input class="sw-input" id="contrasenaNueva" name="contrasenaNueva" type="password" autocomplete="new-password" maxlength="50" required>
            </div>

            <div class="sw-campo">
                <label class="sw-label" for="confirmarContrasena">Repetir nueva contraseña</label>
                <input class="sw-input" id="confirmarContrasena" name="confirmarContrasena" type="password" autocomplete="new-password" maxlength="50" required>
            </div>

            <div class="sw-form-acciones">
                <button type="submit" class="sw-btn sw-btn-solido sw-btn-bloque">Guardar</button>
            </div>
        </form>

        <p class="sw-auth-pie">
            <a asp-controller="Perfil" asp-action="Index" class="sw-link">Volver a mi perfil</a>
        </p>
    </div>
</section>
