@{
    Swappit.Models.Usuarios? usuario = ViewBag.usuario;
}

@if (usuario == null)
{
    <div class="container-xl py-5">
        <div class="tarjeta-blanca angosta p-5 text-center mx-auto">
            <i class="bi bi-person-x fs-1 texto-suave" aria-hidden="true"></i>
            <h1 class="letra-serif h2 mt-3">Este usuario no existe</h1>
            <p class="texto-suave mb-4">Puede que el enlace esté mal.</p>
            <a href="@Url.Action("Buscar", "Articulos")" class="btn boton-bordo">Ver artículos</a>
        </div>
    </div>
    return;
}

@{
    string? foto = ViewBag.foto;
    List<Swappit.Models.ViewModels.ArticuloCardViewModel> articulos = ViewBag.articulos;
    string iniciales = ViewBag.iniciales;
    string ubicacion = ViewBag.ubicacion;
    bool tieneDescripcion = ViewBag.tieneDescripcion;
    Swappit.Models.ViewModels.PlanViewModel? plan = ViewBag.plan;
}

<div class="container-xl py-4 py-lg-5">
    <div class="row g-4">

        <!-- ===== Nombre + foto ===== -->
        <div class="col-12">
            <div class="tarjeta-blanca p-4 p-lg-5">
                <div class="d-flex flex-column flex-sm-row align-items-center gap-4 text-center text-sm-start">
                    <div class="foto-redonda-grande" data-iniciales="@iniciales">
                        @if (foto != null)
                        {
                            <img src="@foto" alt="Foto de @usuario.Nombre">
                        }
                        else
                        {
                            <span aria-hidden="true">@iniciales</span>
                        }
                    </div>
                    <div class="sin-ancho-minimo">
                        <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-sm-start gap-2">
                            <h1 class="letra-serif h2 mb-0">@usuario.Nombre @usuario.Apellido</h1>
                            @if (plan != null && !plan.EsGratis)
                            {
                                <span class="insignia tono-@plan.Tono"><i class="bi bi-patch-check-fill" aria-hidden="true"></i><span class="visually-hidden">Usuario</span> @plan.Nombre</span>
                            }
                        </div>
                        <p class="texto-suave mb-1">@@@usuario.Usuario</p>
                        <a href="#titulo-opiniones" class="d-inline-block text-reset text-decoration-none small mb-2"><partial name="_Reputacion" /></a>
                        @if (tieneDescripcion)
                        {
                            <p class="texto-con-saltos mb-3">@usuario.Descripcion</p>
                        }
                        <div class="d-flex flex-wrap justify-content-center justify-content-sm-start gap-3 texto-suave small">
                            @if (ubicacion != "")
                            {
                                <span><i class="bi bi-geo-alt me-1" aria-hidden="true"></i>@ubicacion</span>
                            }
                            <span><i class="bi bi-box-seam me-1" aria-hidden="true"></i>@articulos.Count @(articulos.Count == 1 ? "artículo publicado" : "artículos publicados")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ===== Artículos publicados ===== -->
        <div class="col-12">
            <section class="tarjeta-blanca p-4" aria-labelledby="titulo-articulos-usuario">
                <h2 class="letra-serif h3 mb-4" id="titulo-articulos-usuario">Artículos de @usuario.Nombre</h2>

                @if (articulos.Count > 0)
                {
                    <div class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-3">
                        @foreach (var articulo in articulos)
                        {
                            ViewBag.articulo = articulo;
                            <partial name="_CardObjeto" />
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="bi bi-box-seam fs-1 texto-suave" aria-hidden="true"></i>
                        <p class="texto-suave mt-2 mb-0">@usuario.Nombre todavía no publicó ningún artículo.</p>
                    </div>
                }
            </section>
        </div>

        <!-- ===== Opiniones ===== -->
        <div class="col-12">
            <partial name="_Opiniones" />
        </div>
    </div>
</div>
