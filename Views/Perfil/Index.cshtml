@{
    ViewData["Title"] = "Mi perfil";
    Swappit.Models.Usuarios usuario = ViewBag.usuario;
    Swappit.Models.Provincias? provincia = ViewBag.provincia;
    string iniciales = $"{usuario.Nombre?.FirstOrDefault()}{usuario.Apellido?.FirstOrDefault()}".ToUpper();
    string ubicacion = string.Join(", ", new[] { usuario.Barrio, provincia?.Nombre }.Where(s => !string.IsNullOrWhiteSpace(s)));
    List<Swappit.Models.Provincias> provincias = ViewBag.provincias;
    string? foto = ViewBag.foto;
    List<Swappit.Models.ViewModels.ArticuloCardViewModel> articulos = ViewBag.articulos;
    List<Swappit.Models.ViewModels.IntercambioViewModel> intercambios = ViewBag.intercambios;
    string? errorPerfil = TempData["ErrorPerfil"] as string;
    string? mensajePerfil = TempData["MensajePerfil"] as string;
}

<div class="container-xl py-4 py-lg-5">
    @if (mensajePerfil != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="status">
            <i class="bi bi-check-circle-fill me-1"></i> @mensajePerfil
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <div class="row g-4">

        <!-- ===== Nombre + foto ===== -->
        <div class="col-lg-6 d-flex flex-column gap-4">
            <div class="sw-card p-4 flex-grow-1 d-flex align-items-center">
                <div class="d-flex flex-column flex-sm-row align-items-center gap-4 text-center text-sm-start w-100">
                    <div class="sw-perfil-avatar" data-iniciales="@iniciales">
                        @if (foto != null)
                        {
                            <img src="@foto" alt="Foto de @usuario.Nombre">
                        }
                        else
                        {
                            <span data-campo="iniciales">@iniciales</span>
                        }
                        <button type="button" class="sw-perfil-avatar-editar border-0" aria-label="Cambiar foto"
                                data-bs-toggle="modal" data-bs-target="#modal-editar-perfil" data-elegir-foto><i class="bi bi-camera-fill"></i></button>
                    </div>
                    <div>
                        <h1 class="font-titulo h2 mb-0" data-campo="nombreCompleto">@usuario.Nombre @usuario.Apellido</h1>
                        <p class="text-suave mb-2">@@<span data-campo="usuario">@usuario.Usuario</span></p>
                        @if (!string.IsNullOrWhiteSpace(usuario.Descripcion))
                        {
                            <p class="sw-perfil-descripcion mb-3" data-campo="descripcion">@usuario.Descripcion</p>
                        }
                        else
                        {
                            <p class="mb-3">
                                <button type="button" class="btn btn-link text-suave p-0" data-bs-toggle="modal" data-bs-target="#modal-editar-perfil"
                                        data-enfocar="Descripcion"><i class="bi bi-plus-circle me-1"></i> Agregá una descripción</button>
                            </p>
                        }
                        <button type="button" class="btn btn-sw-primario btn-sm" data-bs-toggle="modal" data-bs-target="#modal-editar-perfil"><i class="bi bi-pencil-square me-1"></i> Editar perfil</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ===== Información personal (tabla Usuarios) ===== -->
        <div class="col-lg-6">
            <div class="sw-card p-4 h-100">
                <div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
                    <h2 class="h5 fw-bold mb-0">Información personal</h2>
                    <button type="button" class="btn btn-link text-suave p-0" aria-label="Editar información"
                            data-bs-toggle="modal" data-bs-target="#modal-editar-perfil"><i class="bi bi-pencil"></i></button>
                </div>
                <ul class="list-unstyled d-flex flex-column gap-4 mb-0">
                    <li class="d-flex align-items-center gap-3">
                        <span class="sw-info-icono" aria-hidden="true"><i class="bi bi-person-fill"></i></span>
                        <span class="fw-semibold sw-info-etiqueta">Usuario</span>
                        <span class="text-suave sw-info-valor" data-campo="usuario">@@@usuario.Usuario</span>
                    </li>
                    <li class="d-flex align-items-center gap-3">
                        <span class="sw-info-icono" aria-hidden="true"><i class="bi bi-envelope-fill"></i></span>
                        <span class="fw-semibold sw-info-etiqueta">Email</span>
                        <span class="text-suave sw-info-valor" data-campo="mail">@usuario.Mail</span>
                    </li>
                    <li class="d-flex align-items-center gap-3">
                        <span class="sw-info-icono" aria-hidden="true"><i class="bi bi-telephone-fill"></i></span>
                        <span class="fw-semibold sw-info-etiqueta">Teléfono</span>
                        <span class="text-suave sw-info-valor" data-campo="telefono">@(usuario.Telefono != 0 ? usuario.Telefono.ToString() : "—")</span>
                    </li>
                    <li class="d-flex align-items-center gap-3">
                        <span class="sw-info-icono" aria-hidden="true"><i class="bi bi-geo-alt-fill"></i></span>
                        <span class="fw-semibold sw-info-etiqueta">Barrio</span>
                        <span class="text-suave sw-info-valor" data-campo="barrio">@(ubicacion != "" ? ubicacion : "—")</span>
                    </li>
                    <li class="d-flex align-items-center gap-3">
                        <span class="sw-info-icono" aria-hidden="true"><i class="bi bi-calendar-fill"></i></span>
                        <span class="fw-semibold sw-info-etiqueta">Edad</span>
                        <span class="text-suave sw-info-valor" data-campo="edad">@usuario.Edad años</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- ===== Artículos publicados (Articulos.IdUsuarios = usuario del perfil) ===== -->
        <div class="col-12">
            <section class="sw-card p-4" aria-labelledby="titulo-mis-articulos">
                <div class="d-flex justify-content-between align-items-center gap-3 mb-4">
                    <h2 class="font-titulo h3 mb-0" id="titulo-mis-articulos">
                        Mis artículos publicados
                        @if (articulos.Count > 0)
                        {
                            <span class="text-suave fs-6 fw-normal ms-1">(@articulos.Count)</span>
                        }
                    </h2>
                    <a href="@Url.Action("Index", "Publicar")" class="btn btn-sw-primario btn-sm text-nowrap flex-shrink-0"><i class="bi bi-plus-lg me-1"></i> Publicar</a>
                </div>

                @if (articulos.Count > 0)
                {
                    <!-- Misma card que el catálogo (Views/Shared/_CardObjeto.cshtml) -->
                    <div id="mis-articulos" class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-3">
                        @foreach (var articulo in articulos)
                        {
                            ViewBag.articulo = articulo;
                            <partial name="_CardObjeto" />
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="bi bi-box-seam fs-1 text-suave"></i>
                        <p class="text-suave mt-2 mb-0">Todavía no publicaste ningún artículo.</p>
                    </div>
                }
            </section>
        </div>

        <!-- ===== Historial de intercambios: los últimos de la tabla Intercambios (todos en Intercambio/Index) ===== -->
        <div class="col-12">
            <section class="sw-card p-4" aria-labelledby="titulo-historial">
                <div class="d-flex justify-content-between align-items-center gap-3 mb-4">
                    <h2 class="font-titulo h3 mb-0" id="titulo-historial">Historial de intercambios</h2>
                    @if (intercambios.Count > 0)
                    {
                        <a href="@Url.Action("Index", "Intercambio")" class="fw-semibold text-decoration-none text-primario text-nowrap">Ver todos <i class="bi bi-chevron-right"></i></a>
                    }
                </div>

                @if (intercambios.Count > 0)
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var intercambio in intercambios)
                        {
                            ViewBag.fila = intercambio;
                            <partial name="_FilaIntercambio" />
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="bi bi-arrow-left-right fs-1 text-suave"></i>
                        <p class="text-suave mt-2 mb-0">Todavía no tenés intercambios. Cuando propongas uno o te llegue una propuesta, lo vas a ver acá.</p>
                    </div>
                }
            </section>
        </div>
    </div>
</div>

<!-- ===== Pop up: Editar perfil (lo maneja wwwroot/js/perfil.js) ===== -->
<div class="modal fade sw-modal" id="modal-editar-perfil" tabindex="-1" aria-labelledby="titulo-editar-perfil" aria-hidden="true"
     data-error="@errorPerfil">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <form class="modal-content" method="post" action="@Url.Action("Editar", "Perfil")" asp-antiforgery="true" enctype="multipart/form-data">
            <div class="modal-header">
                <h2 class="modal-title font-titulo h3 mb-0" id="titulo-editar-perfil">Editar perfil</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body d-flex flex-column gap-4">
                @if (errorPerfil != null)
                {
                    <p class="sw-error-resumen mb-0" role="alert">@errorPerfil</p>
                }

                <!-- Foto -->
                <div class="d-flex flex-column flex-sm-row align-items-center gap-4">
                    <div class="sw-perfil-avatar sw-perfil-avatar--chico" id="vista-previa-foto" data-iniciales="@iniciales">
                        @if (foto != null)
                        {
                            <img src="@foto" alt="Foto actual">
                        }
                        else
                        {
                            <span>@iniciales</span>
                        }
                    </div>
                    <div class="d-flex flex-column align-items-center align-items-sm-start gap-2">
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="sw-btn sw-btn-contorno" data-elegir-foto><i class="bi bi-camera me-1"></i> Cambiar foto</button>
                            <button type="button" class="sw-btn sw-btn-contorno @(foto == null ? "d-none" : "")" id="quitar-foto">Quitar foto</button>
                        </div>
                        <input type="file" class="d-none" id="Foto" name="Foto" accept=".jpg,.jpeg,.png,image/jpeg,image/png"
                               data-max-mb="@Swappit.Models.ViewModels.EditarPerfilViewModel.MaxFotoMB">
                        <input type="hidden" id="QuitarFoto" name="QuitarFoto" value="false">
                        <span class="sw-ayuda">JPG o PNG, hasta @Swappit.Models.ViewModels.EditarPerfilViewModel.MaxFotoMB MB.</span>
                        <span class="sw-error" id="error-foto" role="alert"></span>
                    </div>
                </div>

                <div class="sw-fila">
                    <div class="sw-campo">
                        <label class="sw-label" for="Nombre">Nombre</label>
                        <input class="sw-input" id="Nombre" name="Nombre" value="@usuario.Nombre" maxlength="50" autocomplete="given-name" required>
                    </div>
                    <div class="sw-campo">
                        <label class="sw-label" for="Apellido">Apellido</label>
                        <input class="sw-input" id="Apellido" name="Apellido" value="@usuario.Apellido" maxlength="50" autocomplete="family-name" required>
                    </div>
                </div>

                <div class="sw-fila">
                    <div class="sw-campo">
                        <label class="sw-label" for="Usuario">Usuario</label>
                        <input class="sw-input" id="Usuario" name="Usuario" value="@usuario.Usuario" maxlength="50" autocomplete="username" required>
                    </div>
                    <div class="sw-campo">
                        <label class="sw-label" for="Telefono">Teléfono</label>
                        <input class="sw-input" id="Telefono" name="Telefono" type="tel" value="@(usuario.Telefono != 0 ? usuario.Telefono.ToString() : "")"
                               placeholder="11 0000 0000" autocomplete="tel">
                    </div>
                </div>

                <div class="sw-fila">
                    <div class="sw-campo">
                        <label class="sw-label" for="Barrio">Barrio</label>
                        <input class="sw-input" id="Barrio" name="Barrio" value="@usuario.Barrio" maxlength="50" placeholder="Ej: Palermo">
                    </div>
                    <div class="sw-campo">
                        <label class="sw-label" for="IdProvincias">Provincia</label>
                        <select class="sw-input sw-select" id="IdProvincias" name="IdProvincias" required>
                            @foreach (var p in provincias)
                            {
                                <option value="@p.IdProvincia" selected="@(p.IdProvincia == usuario.IdProvincias)">@p.Nombre</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="sw-campo">
                    <label class="sw-label" for="Descripcion">Descripción</label>
                    <textarea class="sw-input sw-textarea" id="Descripcion" name="Descripcion" rows="4" maxlength="@Swappit.Models.ViewModels.EditarPerfilViewModel.MaxDescripcion"
                              placeholder="Contá quién sos, qué te gusta intercambiar o cómo preferís coordinar…">@usuario.Descripcion</textarea>
                    <span class="sw-contador" id="contador-descripcion" aria-live="polite">0/@Swappit.Models.ViewModels.EditarPerfilViewModel.MaxDescripcion</span>
                    <span class="sw-ayuda">La ven todos en tu perfil público.</span>
                </div>

                <div class="sw-campo">
                    <label class="sw-label" for="mail-perfil">Email</label>
                    <input class="sw-input" id="mail-perfil" value="@usuario.Mail" disabled>
                    <span class="sw-ayuda">El email no se puede cambiar.</span>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="sw-btn sw-btn-contorno" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="sw-btn sw-btn-solido">Guardar cambios</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/perfil.js" asp-append-version="true"></script>
}
