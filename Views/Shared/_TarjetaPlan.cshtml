@{
    Swappit.Models.ViewModels.PlanViewModel plan = ViewBag.tarjetaPlan;
    int? idPlanActual = ViewBag.idPlanActual;
    bool esVisitante = ViewBag.esVisitante ?? true;
    bool esActual = !esVisitante && plan.Id == idPlanActual;
}
<div class="col">
    <article class="tarjeta-precio tono-@plan.Tono @(esActual ? "resaltada" : "")" aria-labelledby="plan-@plan.Id">
        @if (esActual)
        {
            <span class="pastilla-flotante"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> Tu plan actual</span>
        }
        <header>
            <span class="tarjeta-precio-pastilla">@plan.Etiqueta</span>
            <h3 class="tarjeta-precio-titulo" id="plan-@plan.Id">@plan.Nombre</h3>
        </header>
        <p class="tarjeta-precio-linea">
            <span class="numero-grande">@plan.Precio</span>
            @if (!plan.EsGratis)
            {
                <span class="sufijo-suave" aria-hidden="true">/mes</span>
                <span class="visually-hidden">por mes</span>
            }
        </p>
        <ul class="lista-tildes">
            @foreach (string beneficio in plan.Beneficios)
            {
                <li><i class="bi bi-check2" aria-hidden="true"></i><span>@beneficio</span></li>
            }
        </ul>
        <div class="empujado-abajo">
            @if (esVisitante)
            {
                <a href="@Url.Action("Registro", "Account", new { plan = plan.Id })" class="btn tarjeta-precio-boton">@(plan.EsGratis ? "Empezar gratis" : $"Empezar con {plan.Nombre}")</a>
            }
            else if (esActual)
            {
                <button type="button" class="btn tarjeta-precio-boton" disabled>Es tu plan</button>
            }
            else if (plan.EsGratis)
            {
                <form method="post" action="@Url.Action("Cambiar", "Planes")" asp-antiforgery="true">
                    <input type="hidden" name="idPlan" value="@plan.Id">
                    <button type="submit" class="btn tarjeta-precio-boton">Cambiar a @plan.Nombre</button>
                </form>
            }
            else
            {
                <a href="@Url.Action("Pago", "Planes", new { id = plan.Id })" class="btn tarjeta-precio-boton">Pasarme a @plan.Nombre</a>
            }
        </div>
    </article>
</div>
