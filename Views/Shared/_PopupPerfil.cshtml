@{
    string? iniciales = ViewBag.sesionIniciales;
    string? foto = ViewBag.sesionFoto;
    string? nombre = ViewBag.sesionNombre;
    string? usuario = ViewBag.sesionUsuario;
}
<section id="popup-perfil" class="desplegable desplegable-angosto" aria-labelledby="perfil-titulo">
    <header class="desplegable-cabecera justify-content-start">
        <span class="foto-redonda-chica" data-iniciales="@iniciales" aria-hidden="true">@if (foto != null) { <img src="@foto" alt=""> } else { @iniciales }</span>
        <div class="sin-ancho-minimo">
            <h2 id="perfil-titulo" class="desplegable-titulo text-truncate">@(string.IsNullOrEmpty(nombre) ? "Mi cuenta" : nombre)</h2>
            @if (!string.IsNullOrEmpty(usuario))
            {
                <p class="texto-suave small mb-0 text-truncate">@@@usuario</p>
            }
        </div>
    </header>

    <nav aria-labelledby="perfil-titulo">
        <ul class="lista-enlaces">
            <li><a href="@Url.Action("Index", "Perfil")" class="enlace-con-icono"><i class="bi bi-person" aria-hidden="true"></i> Ver mi perfil</a></li>
            <li><a href="@Url.Action("Index", "Perfil")#editar-perfil" class="enlace-con-icono"><i class="bi bi-pencil-square" aria-hidden="true"></i> Editar perfil</a></li>
            <li><a href="@Url.Action("Index", "Intercambio")" class="enlace-con-icono"><i class="bi bi-arrow-left-right" aria-hidden="true"></i> Mis intercambios</a></li>
            <li><a href="@Url.Action("Index", "Favoritos")" class="enlace-con-icono"><i class="bi bi-heart" aria-hidden="true"></i> Favoritos</a></li>
            <li><a href="@Url.Action("Index", "Planes")" class="enlace-con-icono"><i class="bi bi-gem" aria-hidden="true"></i> Mi plan</a></li>
            <li><a href="@Url.Action("CambiarContrasena", "Account")" class="enlace-con-icono"><i class="bi bi-key" aria-hidden="true"></i> Cambiar contraseña</a></li>
        </ul>
        <div class="desplegable-pie">
            <a href="@Url.Action("Logout", "Account")" class="enlace-con-icono tono-bordo"><i class="bi bi-box-arrow-right" aria-hidden="true"></i> Cerrar sesión</a>
        </div>
    </nav>
</section>
