@{
    Swappit.Models.ViewModels.ArticuloCardViewModel opcion = ViewBag.opcion;
    string tipo = ViewBag.opcionTipo;
    string nombre = ViewBag.opcionNombre;
    bool marcada = ViewBag.opcionMarcada;
    bool requerida = ViewBag.opcionRequerida;
}
<label class="opcion-tarjeta">
    <input type="@tipo" class="radio-oculto" name="@nombre" value="@opcion.IdArticulos" checked="@marcada" required="@requerida">
    <span class="opcion-tarjeta-cuerpo">
        <span class="marco-imagen opcion-tarjeta-imagen">
            @if (opcion.TieneImagen)
            {
                <img src="@opcion.Imagen" alt="">
            }
        </span>
        <span class="sin-ancho-minimo">
            <span class="d-block fw-semibold text-truncate">@opcion.Nombre</span>
            <span class="d-block texto-suave small">@opcion.Estado</span>
        </span>
        <i class="bi bi-check-circle-fill opcion-tarjeta-check" aria-hidden="true"></i>
    </span>
</label>
