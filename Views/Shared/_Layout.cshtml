<!DOCTYPE html>
<html lang="es">
@{
    int? usuarioId = ViewBag.sesionId;
    bool esVisitante = ViewBag.esVisitante ?? true;
    string? iniciales = ViewBag.sesionIniciales;
    string? foto = ViewBag.sesionFoto;
}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Swappit</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/img/LogoSimple.png">
</head>
<body data-usuario="@usuarioId" data-url-login="@Url.Action("Index", "Account")">
    <a href="#contenido" class="enlace-oculto">Saltar al contenido</a>

    <!-- ===== Header ===== -->
    <header class="barra-fija">
        <div class="container-xl d-flex align-items-center gap-3">
            <a href="@Url.Action("Index", "Home")" class="enlace-imagen">
                <img src="~/img/logo.png" class="imagen-alto-fijo @(esVisitante ? "" : "d-none d-sm-block")" alt="Swappit">
                @if (!esVisitante)
                {
                    <img src="~/img/LogoSimple.png" class="imagen-alto-fijo d-sm-none" alt="Swappit">
                }
            </a>

            <form action="@Url.Action("Buscar", "Articulos")" method="get" class="campo-redondeado flex-grow-1 d-none d-md-flex" role="search">
                <i class="bi bi-search texto-suave" aria-hidden="true"></i>
                <input type="search" name="q" placeholder="Buscá sillones, heladeras, lámparas..." aria-label="Buscar objetos">

                <button type="submit" class="boton-redondo-bordo" aria-label="Buscar"><i class="bi bi-search" aria-hidden="true"></i></button>
            </form>

            @if (esVisitante)
            {
                <nav class="d-flex align-items-center gap-3 ms-auto">
                    <a href="@Url.Action("Index", "Planes")" class="text-dark text-decoration-none small fw-semibold d-none d-sm-inline">Planes</a>
                    <a href="@Url.Action("Index", "Account")" class="text-dark text-decoration-none small fw-semibold">Iniciar sesión</a>
                    <a href="@Url.Action("Registro", "Account")" class="btn boton-bordo btn-sm">Registrarse</a>
                </nav>
            }
            else
            {
                <nav class="d-flex align-items-center gap-1 gap-sm-2 ms-auto" aria-label="Mi cuenta">
                    <a href="@Url.Action("Index", "Favoritos")" class="boton-icono" title="Favoritos" aria-label="Favoritos"><i class="bi bi-heart" aria-hidden="true"></i></a>
                    <a href="@Url.Action("Index", "Intercambio")" class="boton-icono" title="Mis intercambios" aria-label="Mis intercambios"><i class="bi bi-arrow-left-right" aria-hidden="true"></i></a>
                    <a href="@Url.Action("Index", "Chat")" class="boton-icono" title="Mensajes" aria-label="Mensajes"><i class="bi bi-chat-dots" aria-hidden="true"></i></a>
                    <div class="contenedor-relativo" data-notif data-url-no-leidas="@Url.Action("NoLeidas", "Notificaciones")" data-url-lista="@Url.Action("Lista", "Notificaciones")">
                        <button type="button" class="boton-icono" title="Notificaciones" aria-label="Notificaciones" aria-expanded="false" aria-controls="popup-notificaciones" data-notif-boton><i class="bi bi-bell" aria-hidden="true"></i><span class="numero-flotante" data-notif-contador aria-hidden="true" hidden></span></button>
                        <partial name="_PopupNotificaciones" />
                    </div>
                    <a href="@Url.Action("Index", "Perfil")" class="foto-redonda-mini mx-sm-1" data-iniciales="@iniciales" title="Mi perfil" aria-label="Mi perfil">@if (foto != null) { <img src="@foto" alt=""> } else { @iniciales }</a>
                    <a href="@Url.Action("Index", "Publicar")" class="btn boton-bordo btn-sm d-none d-sm-inline-flex align-items-center gap-1"><i class="bi bi-plus-lg" aria-hidden="true"></i> Publicar</a>
                    <a href="@Url.Action("Index", "Publicar")" class="boton-icono boton-icono-bordo d-sm-none" title="Publicar" aria-label="Publicar"><i class="bi bi-plus-lg" aria-hidden="true"></i></a>
                    <a href="@Url.Action("Logout", "Account")" class="boton-icono d-none d-sm-inline-flex" title="Cerrar sesión" aria-label="Cerrar sesión"><i class="bi bi-box-arrow-right" aria-hidden="true"></i></a>
                </nav>
            }
        </div>

        <div class="container-xl d-md-none">
            <form action="@Url.Action("Buscar", "Articulos")" method="get" class="campo-redondeado campo-movil" role="search">
                <i class="bi bi-search texto-suave" aria-hidden="true"></i>
                <input type="search" name="q" placeholder="Buscá sillones, lámparas..." aria-label="Buscar objetos">
                <button type="submit" class="boton-redondo-bordo" aria-label="Buscar"><i class="bi bi-search" aria-hidden="true"></i></button>
            </form>
        </div>
    </header>

    <main id="contenido" tabindex="-1">
        @RenderBody()
    </main>

    <!-- ===== Footer ===== -->
    <footer class="franja-celeste">
        <div class="container-xl">
            <div class="row gy-4">
                <div class="col-lg-6">
                    <a href="@Url.Action("Index", "Home")" class="enlace-imagen enlace-imagen-grande mb-2"><img src="~/img/logo.png" class="imagen-alto-fijo" alt="Swappit"></a>
                    <p class="small mb-0">Intercambiá. Conectá. Reutilizá.</p>
                </div>
                <nav class="col-6 col-lg-2 ms-lg-auto" aria-labelledby="pie-swappit">
                    <h2 id="pie-swappit">Swappit</h2>
                    <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
                        @if (esVisitante)
                        {
                            <li><a href="@Url.Action("Index", "Home")#como-funciona">Cómo funciona</a></li>
                        }
                        <li><a href="@Url.Action("Index", "Planes")">Planes</a></li>
                        <li><a href="@Url.Action("Privacy", "Home")">Privacidad</a></li>
                    </ul>
                </nav>
                <nav class="col-6 col-lg-2" aria-labelledby="pie-ayuda">
                    <h2 id="pie-ayuda">Ayuda</h2>
                    <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
                        <li><a href="mailto:swappit9@gmail.com">Contacto</a></li>
                        <li><a href="mailto:swappit9@gmail.com?subject=Problema%20en%20Swappit">Reportar un problema</a></li>
                    </ul>
                </nav>
            </div>
        </div>
    </footer>

    @if (!esVisitante)
    {
        <form hidden data-favoritos method="post" asp-antiforgery="true" action="@Url.Action("Alternar", "Favoritos")"
              data-url-ids="@Url.Action("Ids", "Favoritos")" data-url-importar="@Url.Action("Importar", "Favoritos")"></form>
    }

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/plantillas.js" asp-append-version="true"></script>
    <script src="~/js/imagenes.js" asp-append-version="true"></script>
    <script src="~/js/favoritos.js" asp-append-version="true"></script>
    <script src="~/js/notificaciones.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
