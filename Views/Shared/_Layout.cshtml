<!DOCTYPE html>
<html lang="es">
@{
    // Si no hay usuario en la sesión (ver AccountController) se muestra el header de visitante
    var esVisitante = Context.Session.GetInt32("UsuarioId") == null;
    var iniciales = Context.Session.GetString("Iniciales");
    var foto = Context.Session.GetString("Foto");
}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Swappit</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Forum&family=Questrial&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a href="#contenido" class="sw-saltar">Saltar al contenido</a>

    <!-- ===== Header ===== -->
    <header class="sw-header">
        <div class="container-xl d-flex align-items-center gap-3">
            <a asp-controller="Home" asp-action="Index" class="sw-logo">
                <img src="~/img/logo.png" class="sw-logo-img" alt="Swappit">
            </a>

            <!-- Buscador (va a Home/Buscar con ?q=) -->
            <form asp-controller="Home" asp-action="Buscar" method="get" class="sw-buscador flex-grow-1 d-none d-md-flex" role="search">
                <i class="bi bi-search text-suave" aria-hidden="true"></i>
                <input type="search" name="q" placeholder="Buscá sillones, heladeras, lámparas..." aria-label="Buscar objetos">
                <button type="button" class="sw-buscador-ubicacion d-none d-lg-inline">
                    <i class="bi bi-geo-alt"></i> <span id="ubicacion-actual">Palermo, CABA</span> <i class="bi bi-chevron-down small"></i>
                </button>
                <button type="submit" class="sw-btn-icono" aria-label="Buscar"><i class="bi bi-search"></i></button>
            </form>

            @if (esVisitante)
            {
                <nav class="d-flex align-items-center gap-3 ms-auto">
                    <a asp-controller="Account" asp-action="Index" class="text-dark text-decoration-none small fw-semibold">Iniciar sesión</a>
                    <a asp-controller="Account" asp-action="Registro" class="btn btn-sw-secundario btn-sm">Registrarse</a>
                </nav>
            }
            else
            {
                <nav class="d-flex align-items-center gap-1 gap-sm-2 ms-auto" aria-label="Mi cuenta">
                    <a href="#" class="sw-header-accion" title="Favoritos" aria-label="Favoritos"><i class="bi bi-heart" aria-hidden="true"></i></a>
                    <a asp-controller="Home" asp-action="Chat" class="sw-header-accion" title="Mensajes" aria-label="Mensajes"><i class="bi bi-chat-dots" aria-hidden="true"></i><span class="sw-punto"></span></a>
                    <a href="#" class="sw-header-accion" title="Notificaciones" aria-label="Notificaciones"><i class="bi bi-bell" aria-hidden="true"></i></a>
                    <a asp-controller="Account" asp-action="Perfil" class="sw-avatar mx-1" title="Mi perfil" aria-label="Mi perfil">@if (foto != null) { <img src="@foto" alt=""> } else { @iniciales }</a>
                    <a asp-controller="Home" asp-action="Publicar" class="btn btn-sw-secundario btn-sm d-none d-sm-inline-flex align-items-center gap-1"><i class="bi bi-plus-lg" aria-hidden="true"></i> Publicar</a>
                    <!-- En celulares el botón Publicar queda como ícono para que entre en el header -->
                    <a asp-controller="Home" asp-action="Publicar" class="sw-header-accion sw-header-accion--publicar d-sm-none" title="Publicar" aria-label="Publicar"><i class="bi bi-plus-lg" aria-hidden="true"></i></a>
                    <a asp-controller="Account" asp-action="Logout" class="sw-header-accion" title="Cerrar sesión" aria-label="Cerrar sesión"><i class="bi bi-box-arrow-right" aria-hidden="true"></i></a>
                </nav>
            }
        </div>

        <!-- Buscador en celulares (en pantallas medianas en adelante está en la fila de arriba) -->
        <div class="container-xl d-md-none">
            <form asp-controller="Home" asp-action="Buscar" method="get" class="sw-buscador sw-buscador--mobile" role="search">
                <i class="bi bi-search text-suave" aria-hidden="true"></i>
                <input type="search" name="q" placeholder="Buscá sillones, lámparas..." aria-label="Buscar objetos">
                <button type="submit" class="sw-btn-icono" aria-label="Buscar"><i class="bi bi-search" aria-hidden="true"></i></button>
            </form>
        </div>
    </header>

    <main id="contenido" tabindex="-1">
        @RenderBody()
    </main>

    <!-- ===== Footer ===== -->
    <footer class="sw-footer">
        <div class="container-xl">
            <div class="row gy-4">
                <div class="col-lg-6">
                    <a asp-controller="Home" asp-action="Index" class="sw-logo sw-logo-footer mb-2"><img src="~/img/logo.png" class="sw-logo-img" alt="Swappit"></a>
                    <p class="small mb-0">Intercambiá. Conectá. Reutilizá.</p>
                </div>
                <div class="col-4 col-lg-2">
                    <h6>Swappit</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
                        <li><a asp-controller="Home" asp-action="Index" asp-fragment="como-funciona">Cómo funciona</a></li>
                        <li><a href="#">Consejos de seguridad</a></li>
                        <li><a href="#">Preguntas frecuentes</a></li>
                    </ul>
                </div>
                <div class="col-4 col-lg-2">
                    <h6>Ayuda</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
                        <li><a href="#">Contacto</a></li>
                        <li><a href="#">Reportar un problema</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy">Términos y privacidad</a></li>
                    </ul>
                </div>
                <div class="col-4 col-lg-2">
                    <h6>Seguinos</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
                        <li><a href="#">Instagram</a></li>
                        <li><a href="#">Facebook</a></li>
                        <li><a href="#">WhatsApp</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
