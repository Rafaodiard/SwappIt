@{
    Swappit.Models.ResumenReputacion reputacion = ViewBag.reputacion;
}
@if (reputacion.TieneCalificaciones)
{
    ViewBag.estrellas = reputacion.Estrellas;
    <span class="fila-iconos"><partial name="_Estrellas" /> <strong>@reputacion.PromedioTexto</strong> <span class="texto-suave">· @reputacion.CantidadTexto</span></span>
}
else
{
    <span class="fila-iconos texto-suave"><i class="bi bi-star" aria-hidden="true"></i> Sin calificaciones todavía</span>
}
