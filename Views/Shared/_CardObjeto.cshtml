@*
    Card / Objeto  (componente "10. Card" del UI Kit)
    ------------------------------------------------------------
    Se renderiza desde el servidor con un ArticuloCardViewModel en ViewBag.articulo:
    ViewBag.articulo = articulo;
    <partial name="_CardObjeto" />

    Mantiene data-template / data-campo para que swappit.renderObjetos (site.js)
    pueda seguir usándola como molde si más adelante se carga por JS.

    Campos:
      imagen   -> primera fila de Imagenes del artículo (si no hay, se ve el placeholder de .sw-img)
      estado   -> Articulos.Estado
      nombre   -> Articulos.Nombre
      barrio   -> Usuarios.Barrio del dueño
    Pendiente (no existe en la BD todavía): distancia y "Busca a cambio".
*@
@{
    Swappit.Models.ViewModels.ArticuloCardViewModel articulo = ViewBag.articulo;
}
<div class="col col-objeto" data-template="card-objeto">
    <article class="card-objeto" data-id="@articulo.IdArticulos">
        <div class="card-objeto-img sw-img">
            @if (!string.IsNullOrEmpty(articulo.Imagen))
            {
                <img src="@articulo.Imagen" alt="@articulo.Nombre" data-campo="imagen">
            }
            else
            {
                <img alt="" data-campo="imagen">
            }
            <span class="card-objeto-estado" data-campo="estado">@articulo.Estado</span>
            <button type="button" class="card-objeto-fav" aria-label="Agregar @articulo.Nombre a favoritos"><i class="bi bi-heart"></i></button>
        </div>
        <div class="card-objeto-body">
            <h3 class="card-objeto-titulo">
                <a asp-controller="Home" asp-action="Articulo" asp-route-id="@articulo.IdArticulos" class="stretched-link text-reset text-decoration-none" data-campo="nombre">@articulo.Nombre</a>
            </h3>
            @if (!string.IsNullOrWhiteSpace(articulo.Barrio))
            {
                <div class="card-objeto-ubicacion">
                    <i class="bi bi-geo-alt"></i>
                    <span data-campo="barrio">@articulo.Barrio</span>
                </div>
            }
        </div>
    </article>
</div>
