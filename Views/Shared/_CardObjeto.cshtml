@*
    Card / Objeto  (componente "10. Card" del UI Kit)
    ------------------------------------------------------------
    Se renderiza desde el servidor con un ArticuloCardViewModel en ViewBag.articulo:
    ViewBag.articulo = articulo;
    <partial name="_CardObjeto" />

    Mantiene data-template / data-campo para que swappit.renderObjetos (plantillas.js)
    pueda seguir usándola como molde si más adelante se carga por JS.

    Campos:
      imagen   -> primera fila de Imagenes del artículo (si no hay, se ve el placeholder de .sw-img)
      estado   -> EstadosArticulos.Nombre (por Articulos.IdEstado)
      nombre   -> Articulos.Nombre
      barrio   -> Articulos.Ubicacion (si está vacía, Usuarios.Barrio del dueño)
      motivo   -> por qué se recomienda ("Le interesa algo tuyo" / "Para descubrir"); solo lo completa
                  RecomendacionesController en "Para vos" y en Destacados. Si es null no se muestra.
    Botón de favorito: se muestra siempre, salvo que la vista ponga ViewBag.ocultarFavorito = true
    (ej: "Mis artículos" en el perfil, donde no tiene sentido marcar lo propio).
    Pendiente: "Busca a cambio" (Articulos.IdCategoriaACambio, por ahora solo en el detalle).
*@
@{
    Swappit.Models.ViewModels.ArticuloCardViewModel articulo = ViewBag.articulo;
}
<div class="col col-objeto" data-template="card-objeto">
    <article class="card-objeto" data-id="@articulo.IdArticulos">
        <div class="card-objeto-img sw-img">
            @if (!string.IsNullOrEmpty(articulo.Imagen))
            {
                <img src="@articulo.Imagen" alt="@articulo.Nombre" data-campo="imagen">
            }
            else
            {
                <img alt="" data-campo="imagen">
            }
            <span class="card-objeto-estado" data-campo="estado">@articulo.Estado</span>
            @if (ViewBag.ocultarFavorito != true)
            {
                @* Favorito: se guarda en la BD (FavoritosController); wwwroot/js/favoritos.js marca el estado al cargar *@
                <button type="button" class="card-objeto-fav" aria-pressed="false" aria-label="Agregar @articulo.Nombre a favoritos"><i class="bi bi-heart" aria-hidden="true"></i></button>
            }
        </div>
        <div class="card-objeto-body">
            <h3 class="card-objeto-titulo">
                <a href="@Url.Action("Detalle", "Articulos", new { id = articulo.IdArticulos })" class="stretched-link text-reset text-decoration-none" data-campo="nombre">@articulo.Nombre</a>
            </h3>
            @if (!string.IsNullOrWhiteSpace(articulo.Barrio))
            {
                <div class="card-objeto-ubicacion">
                    <i class="bi bi-geo-alt"></i>
                    <span data-campo="barrio">@articulo.Barrio</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(articulo.Motivo))
            {
                bool descubrir = articulo.Motivo == Swappit.Controllers.RecomendacionesController.MotivoDescubrir;
                <div class="card-objeto-motivo @(descubrir ? "card-objeto-motivo--descubrir" : "")">
                    <i class="bi @(descubrir ? "bi-compass" : "bi-arrow-left-right")" aria-hidden="true"></i>
                    <span>@articulo.Motivo</span>
                </div>
            }
        </div>
    </article>
</div>
