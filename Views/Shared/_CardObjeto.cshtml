@{
    Swappit.Models.ViewModels.ArticuloCardViewModel articulo = ViewBag.articulo;
    bool ocultarFavorito = ViewBag.ocultarFavorito ?? false;
}
<div class="col columna-tarjeta" data-template="card-objeto">
    <article class="tarjeta-foto" data-id="@articulo.IdArticulos">
        <div class="tarjeta-foto-imagen marco-imagen">
            @if (articulo.TieneImagen)
            {
                <img src="@articulo.Imagen" alt="@articulo.Nombre" data-campo="imagen">
            }
            else
            {
                <img alt="" data-campo="imagen">
            }
            <span class="tarjeta-foto-pastilla" data-campo="estado">@articulo.Estado</span>
            @if (!ocultarFavorito)
            {
                <button type="button" class="tarjeta-foto-boton" aria-pressed="false" aria-label="Agregar @articulo.Nombre a favoritos"><i class="bi bi-heart" aria-hidden="true"></i></button>
            }
        </div>
        <div class="tarjeta-foto-cuerpo">
            <h3 class="tarjeta-foto-titulo">
                <a href="@Url.Action("Detalle", "Articulos", new { id = articulo.IdArticulos })" class="stretched-link text-reset text-decoration-none" data-campo="nombre">@articulo.Nombre</a>
            </h3>
            @if (articulo.TieneBarrio)
            {
                <div class="tarjeta-foto-detalle">
                    <i class="bi bi-geo-alt" aria-hidden="true"></i>
                    <span data-campo="barrio">@articulo.Barrio</span>
                </div>
            }
            @if (articulo.EnIntercambio)
            {
                <div class="tarjeta-foto-etiqueta">
                    <i class="bi bi-arrow-left-right" aria-hidden="true"></i>
                    <span>En intercambio</span>
                </div>
            }
            @if (articulo.TieneMotivo)
            {
                <div class="tarjeta-foto-etiqueta @(articulo.EsParaDescubrir ? "tono-celeste" : "")">
                    <i class="bi @(articulo.EsParaDescubrir ? "bi-compass" : "bi-arrow-left-right")" aria-hidden="true"></i>
                    <span>@articulo.Motivo</span>
                </div>
            }
        </div>
    </article>
</div>
