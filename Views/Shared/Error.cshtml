@{
    ViewData["Title"] = "Error";
    string? requestId = ViewBag.requestId;
}

<div class="container-xl py-5">
    <div class="tarjeta-blanca angosta p-5 text-center mx-auto">
        <span class="circulo-crema-grande mb-3" aria-hidden="true"><i class="bi bi-exclamation-triangle"></i></span>
        <h1 class="letra-serif h2 texto-azul">Algo salió mal</h1>
        <p class="texto-suave mb-4">Hubo un problema al procesar tu pedido. Probá de nuevo en unos minutos.</p>
        <a href="@Url.Action("Index", "Home")" class="btn boton-bordo">Volver al inicio</a>

        @if (requestId != null)
        {
            <p class="small texto-suave mt-4 mb-0">Código del error: <code>@requestId</code></p>
        }
    </div>
</div>
