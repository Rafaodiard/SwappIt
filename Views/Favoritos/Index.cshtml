@*
    Mis favoritos (FavoritosController.Index). Solo con sesión iniciada.
    La página llega vacía: favoritos-lista.js lee los IDs guardados en el navegador (favoritos.js),
    pide las cards a FavoritosController.Tarjetas y las pone en #lista-favoritos.
    Si se saca el corazón de una card, la card se va de la lista.
*@
@{
    ViewData["Title"] = "Favoritos";
}

<div class="container-xl py-4 py-lg-5">
    <header class="mb-4">
        <h1 class="font-titulo display-5 text-primario mb-1">Favoritos</h1>
        <p class="text-suave mb-0">Los artículos que guardaste para ver después.</p>
    </header>

    <p id="favoritos-estado" class="text-suave small mb-3" role="status" aria-live="polite">
        <span class="spinner-border spinner-border-sm text-primario me-1" aria-hidden="true"></span>
        Cargando tus favoritos…
    </p>

    <div id="lista-favoritos" class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-3" data-url-tarjetas="@Url.Action("Tarjetas", "Favoritos")"></div>

    <div id="favoritos-vacio" class="sw-card p-5 text-center" hidden>
        <i class="bi bi-heart fs-1 text-suave" aria-hidden="true"></i>
        <h2 class="font-titulo h3 mt-3">Todavía no tenés favoritos</h2>
        <p class="text-suave">Tocá el corazón de un artículo para guardarlo acá.</p>
        <a href="@Url.Action("Buscar", "Articulos")" class="btn btn-sw-primario">Explorar artículos</a>
    </div>

    <div id="favoritos-error" class="sw-card p-5 text-center" role="alert" hidden>
        <i class="bi bi-exclamation-triangle fs-1 text-suave" aria-hidden="true"></i>
        <h2 class="font-titulo h3 mt-3">No pudimos cargar tus favoritos</h2>
        <p class="text-suave mb-0">Hubo un problema al conectar con la base de datos. Probá de nuevo en un rato.</p>
    </div>
</div>

@section Scripts {
    <script src="~/js/favoritos-lista.js" asp-append-version="true"></script>
}
