@{
    Swappit.Models.ViewModels.PlanViewModel plan = ViewBag.plan;
    Swappit.Models.ViewModels.PlanViewModel? planActual = ViewBag.planActual;
    ViewData["Title"] = $"Pasarme a {plan.Nombre}";
}

<section class="sw-planes-pagina" aria-labelledby="titulo-pago">
    <div class="container-xl">
        <a href="@Url.Action("Index", "Planes")" class="sw-volver mb-3"><i class="bi bi-chevron-left" aria-hidden="true"></i> Planes</a>

        <header class="mb-4 mb-lg-5">
            <p class="sw-eyebrow">Pago</p>
            <h1 class="font-titulo display-5 text-primario mb-0" id="titulo-pago">Pasate a @plan.Nombre</h1>
        </header>

        <div class="row g-4 g-xl-5 align-items-start">
            <div class="col-lg-7">
                <form class="sw-card sw-form sw-pago p-4 p-md-5" method="post" action="@Url.Action("Cambiar", "Planes")" asp-antiforgery="true" autocomplete="off">
                    <input type="hidden" name="idPlan" value="@plan.Id">

                    <div class="sw-pago-aviso" role="note">
                        <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
                        <p class="mb-0"><strong>Pago de demostración.</strong> Swappit todavía no cobra: los datos que escribas acá no se guardan ni se envían. Al confirmar solo se activa el plan.</p>
                    </div>

                    <div class="sw-campo">
                        <label class="sw-label" for="pago-titular">Nombre del titular</label>
                        <input class="sw-input" id="pago-titular" placeholder="Como figura en la tarjeta" maxlength="60" autocomplete="off" required>
                    </div>

                    <div class="sw-campo">
                        <label class="sw-label" for="pago-numero">Número de tarjeta</label>
                        <div class="sw-input-icono">
                            <i class="bi bi-credit-card" aria-hidden="true"></i>
                            <input class="sw-input" id="pago-numero" inputmode="numeric" placeholder="0000 0000 0000 0000" maxlength="19" autocomplete="off" required>
                        </div>
                    </div>

                    <div class="sw-fila">
                        <div class="sw-campo">
                            <label class="sw-label" for="pago-vencimiento">Vencimiento</label>
                            <input class="sw-input" id="pago-vencimiento" inputmode="numeric" placeholder="MM/AA" maxlength="5" autocomplete="off" required>
                        </div>
                        <div class="sw-campo">
                            <label class="sw-label" for="pago-codigo">Código de seguridad</label>
                            <input class="sw-input" id="pago-codigo" inputmode="numeric" placeholder="123" maxlength="4" autocomplete="off" required>
                        </div>
                    </div>

                    <div class="sw-campo">
                        <label class="sw-label" for="pago-dni">DNI del titular</label>
                        <input class="sw-input" id="pago-dni" inputmode="numeric" placeholder="Sin puntos" maxlength="10" autocomplete="off" required>
                    </div>

                    <div class="d-flex flex-column gap-3">
                        <button type="submit" class="sw-btn sw-btn-solido sw-btn-bloque">Pagar @plan.Precio y activar @plan.Nombre</button>
                        <a href="@Url.Action("Index", "Planes")" class="sw-link text-center">Cancelar</a>
                    </div>
                </form>
            </div>

            <div class="col-lg-5">
                <aside class="sw-card sw-pago-resumen sw-pago-resumen--@plan.Clave p-4 p-md-5" aria-labelledby="titulo-resumen-pago">
                    <h2 class="sw-perfil-plan-titulo" id="titulo-resumen-pago">Resumen</h2>
                    <div class="sw-pago-resumen-plan">
                        <span class="sw-plan-nombre">@plan.Nombre</span>
                        <span><span class="sw-plan-monto">@plan.Precio</span><span class="sw-plan-periodo" aria-hidden="true">/mes</span><span class="visually-hidden">por mes</span></span>
                    </div>
                    <ul class="sw-plan-lista">
                        @foreach (string beneficio in plan.Beneficios)
                        {
                            <li><i class="bi bi-check2" aria-hidden="true"></i><span>@beneficio</span></li>
                        }
                    </ul>
                    @if (planActual != null)
                    {
                        <p class="text-suave small mb-0">Hoy tenés el plan @planActual.Nombre. El cambio se aplica apenas confirmás y podés volver a cambiarlo cuando quieras.</p>
                    }
                </aside>
            </div>
        </div>
    </div>
</section>
