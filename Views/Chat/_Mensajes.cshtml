@{
    List<Swappit.Models.ViewModels.MensajeChatViewModel> mensajes = ViewBag.mensajes;
}

@if (mensajes.Count == 0)
{
    <div class="bloque-centrado">
        <i class="bi bi-chat-dots fs-2" aria-hidden="true"></i>
        <p class="mb-0">Todavía no hay mensajes. Escribí para coordinar el intercambio.</p>
    </div>
}

@foreach (var m in mensajes)
{
    if (m.Dia != null)
    {
        <div class="separador-centrado"><span>@m.Dia</span></div>
    }
    <div class="@(m.EsMio ? "globo-derecha" : "globo-izquierda")">
        <div class="globo-texto">@m.Texto</div>
        <div class="globo-pie">
            <time datetime="@m.FechaHtml">@m.Hora</time>
            @if (m.EsMio)
            {
                <i class="bi @(m.Visto ? "bi-check2-all texto-azul" : "bi-check2")" aria-hidden="true"></i>
                <span class="visually-hidden">@(m.Visto ? "Visto" : "Enviado")</span>
            }
        </div>
    </div>
}
