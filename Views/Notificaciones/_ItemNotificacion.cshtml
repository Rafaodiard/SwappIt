@{
    Swappit.Models.ViewModels.NotificacionViewModel n = ViewBag.notificacion;
}
<li class="desplegable-fila @(n.Leida ? "" : "resaltada")">
    <span class="circulo-crema @(n.EsRechazo ? "tono-rosa" : "")" aria-hidden="true"><i class="bi @n.Icono"></i></span>
    <div class="desplegable-fila-texto">
        <p class="mb-0">@if (n.MuestraOtro) {<strong>@n.OtroNombre</strong>}@n.TextoMedio@if (n.TextoDestacado != null) {<strong>@n.TextoDestacado</strong>}@n.TextoFinal</p>
        <div class="desplegable-fila-datos">
            <time datetime="@n.FechaHtml">@n.Hace</time>
            <form action="@Url.Action("Ver", "Notificaciones", new { id = n.Id })" method="post" asp-antiforgery="true">
                <button type="submit" class="desplegable-enlace @(n.EsRechazo ? "tono-bordo" : "")">@n.Accion <i class="bi bi-chevron-right" aria-hidden="true"></i></button>
            </form>
        </div>
    </div>
    @if (!n.Leida)
    {
        <span class="punto-azul"><span class="visually-hidden">Sin leer</span></span>
    }
</li>
