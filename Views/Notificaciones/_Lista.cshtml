@{
    List<Swappit.Models.ViewModels.NotificacionViewModel> nuevas = ViewBag.nuevas;
    List<Swappit.Models.ViewModels.NotificacionViewModel> anteriores = ViewBag.anteriores;
    bool errorCarga = ViewBag.errorCarga;
}

@if (errorCarga)
{
    <div class="desplegable-centrado">
        <span class="circulo-crema tono-rosa" aria-hidden="true"><i class="bi bi-exclamation-lg"></i></span>
        <p class="desplegable-centrado-titulo">No pudimos cargar tus notificaciones</p>
        <p class="desplegable-centrado-texto">Probá de nuevo en un rato.</p>
    </div>
}
else if (nuevas.Count == 0 && anteriores.Count == 0)
{
    <div class="desplegable-centrado">
        <span class="circulo-crema" aria-hidden="true"><i class="bi bi-bell"></i></span>
        <p class="desplegable-centrado-titulo">No tenés notificaciones</p>
        <p class="desplegable-centrado-texto">Acá vas a ver las propuestas de intercambio, los mensajes nuevos y cuándo calificar un intercambio.</p>
    </div>
}
else
{
    <div class="desplegable-lista">
        @if (nuevas.Count > 0)
        {
            <h3 class="desplegable-subtitulo">Nuevas</h3>
            <ul class="list-unstyled mb-0">
                @foreach (var n in nuevas)
                {
                    ViewBag.notificacion = n;
                    <partial name="_ItemNotificacion" />
                }
            </ul>
        }
        @if (anteriores.Count > 0)
        {
            <h3 class="desplegable-subtitulo">Anteriores</h3>
            <ul class="list-unstyled mb-0">
                @foreach (var n in anteriores)
                {
                    ViewBag.notificacion = n;
                    <partial name="_ItemNotificacion" />
                }
            </ul>
        }
    </div>
}
