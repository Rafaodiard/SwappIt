@{
    Swappit.Models.Articulos? articulo = ViewBag.detalle;
    bool errorCarga = ViewBag.errorCarga;
}

@if (articulo == null)
{
    <div class="container-xl py-5">
        <div class="tarjeta-blanca angosta p-5 text-center mx-auto">
            <i class="bi @(errorCarga ? "bi-exclamation-triangle" : "bi-search") fs-1 texto-suave" aria-hidden="true"></i>
            <h1 class="letra-serif h2 mt-3">@(errorCarga ? "No pudimos cargar el artículo" : "Este artículo no existe")</h1>
            <p class="texto-suave mb-4">
                @(errorCarga ? "Hubo un problema al conectar con la base de datos. Probá de nuevo en un rato."
                             : "Puede que lo hayan dado de baja o que el enlace esté mal.")
            </p>
            <a href="@Url.Action("Buscar", "Articulos")" class="btn boton-bordo">Ver otros artículos</a>
        </div>
    </div>
    return;
}

@{
    List<Swappit.Models.ViewModels.FotoArticuloViewModel> fotos = ViewBag.fotos;
    string? fotoPrincipal = ViewBag.fotoPrincipal;
    string altFotoPrincipal = ViewBag.altFotoPrincipal;
    Swappit.Models.Categorias? categoria = ViewBag.categoria;
    string textoACambio = ViewBag.textoACambio;
    Swappit.Models.EstadosArticulos? estado = ViewBag.estado;
    Swappit.Models.Usuarios dueno = ViewBag.dueno;
    string inicialesDueno = ViewBag.inicialesDueno;
    string? fotoDueno = ViewBag.fotoDueno;
    string ubicacion = ViewBag.ubicacion;
    List<Swappit.Models.ViewModels.ArticuloCardViewModel> otrosArticulos = ViewBag.otrosArticulos;
    List<Swappit.Models.ViewModels.ArticuloCardViewModel> misArticulos = ViewBag.misArticulos;
    bool esPropio = ViewBag.esPropio;
    bool logueado = ViewBag.logueado;
    int? idPropuestaEnCurso = ViewBag.idPropuestaEnCurso;
    bool comprometido = ViewBag.comprometido;
    bool puedeProponer = ViewBag.puedeProponer;
    int maxOfrecidos = ViewBag.maxOfrecidos;
    string leyendaOfrecer = ViewBag.leyendaOfrecer;
}

<div class="container-xl py-4 py-lg-5">
    <partial name="_Alertas" />

    <!-- ===== Migas de pan ===== -->
    <nav aria-label="Ubicación" class="mb-4">
        <ol class="breadcrumb small mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("Buscar", "Articulos")" class="text-decoration-none texto-azul">Artículos</a></li>
            @if (categoria != null)
            {
                <li class="breadcrumb-item"><a href="@Url.Action("Buscar", "Articulos", new { categoria = categoria.IdCategorias })" class="text-decoration-none texto-azul">@categoria.Nombre</a></li>
            }
            <li class="breadcrumb-item active text-truncate" aria-current="page">@articulo.Nombre</li>
        </ol>
    </nav>

    <div class="row g-4 g-lg-5">

        <!-- ===== Fotos ===== -->
        <div class="col-lg-7">
            <div class="marco-imagen imagen-con-borde">
                <img id="articulo-foto-principal" src="@fotoPrincipal" alt="@altFotoPrincipal">
            </div>
            @if (fotos.Count > 1)
            {
                <div class="fila-miniaturas" role="group" aria-label="Fotos del artículo">
                    @foreach (var foto in fotos)
                    {
                        <button type="button" class="marco-imagen boton-miniatura" data-foto="@foto.Ruta"
                                aria-label="@foto.Etiqueta" aria-current="@(foto.EsPrimera ? "true" : "false")">
                            <img src="@foto.Ruta" alt="">
                        </button>
                    }
                </div>
            }
            else if (fotos.Count == 0)
            {
                <p class="texto-suave small mt-2 mb-0"><i class="bi bi-image me-1" aria-hidden="true"></i> Este artículo todavía no tiene fotos.</p>
            }
        </div>

        <!-- ===== Información del artículo ===== -->
        <div class="col-lg-5">
            <div class="tarjeta-blanca p-4 p-lg-5 d-flex flex-column gap-4">

                @if (esPropio)
                {
                    <p class="aviso-crema mb-0" role="status"><i class="bi bi-person-check-fill me-1" aria-hidden="true"></i> Este artículo es tuyo. Así lo ven los demás usuarios.</p>
                }
                @if (comprometido)
                {
                    <p class="aviso-crema mb-0" role="status"><i class="bi bi-arrow-left-right me-1" aria-hidden="true"></i> Este artículo ya tiene un intercambio aceptado, así que no aparece en el catálogo.</p>
                }

                <div>
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                        <span class="etiqueta-crema">@estado?.Nombre</span>
                        @if (categoria != null)
                        {
                            <span class="texto-suave small"><i class="bi bi-tag me-1" aria-hidden="true"></i>@categoria.Nombre</span>
                        }
                    </div>
                    <h1 class="letra-serif display-6 texto-azul mb-2">@articulo.Nombre</h1>
                    @if (ubicacion != "")
                    {
                        <p class="texto-suave mb-0"><i class="bi bi-geo-alt me-1" aria-hidden="true"></i>@ubicacion</p>
                    }
                </div>

                <div>
                    <h2 class="h6 fw-bold mb-2">Descripción</h2>
                    <p class="texto-con-saltos mb-0">@articulo.Descripcion</p>
                </div>

                <div>
                    <h2 class="h6 fw-bold mb-2">Busca a cambio</h2>
                    <p class="texto-con-saltos mb-0">@textoACambio</p>
                </div>

                <hr class="linea-divisoria">

                @if (logueado)
                {
                    <div>
                        <h2 class="h6 fw-bold mb-2">Publicado por</h2>
                        <a class="enlace-caja-gris" href="@(esPropio ? Url.Action("Index", "Perfil") : Url.Action("Publico", "Perfil", new { id = dueno.IdUsuarios }))">
                            <span class="foto-redonda-chica" data-iniciales="@inicialesDueno">
                                @if (fotoDueno != null)
                                {
                                    <img src="@fotoDueno" alt="">
                                }
                                else
                                {
                                    <span aria-hidden="true">@inicialesDueno</span>
                                }
                            </span>
                            <span class="flex-grow-1 sin-ancho-minimo">
                                <span class="d-block fw-bold text-truncate">@dueno.Nombre @dueno.Apellido @(esPropio ? "(vos)" : "")</span>
                                <span class="d-block texto-suave small text-truncate">@@@dueno.Usuario</span>
                                <span class="d-block small text-truncate"><partial name="_Reputacion" /></span>
                            </span>
                            <span class="texto-azul small fw-semibold text-nowrap">@(esPropio ? "Mi perfil" : "Ver perfil") <i class="bi bi-chevron-right" aria-hidden="true"></i></span>
                        </a>
                    </div>
                }

                <!-- ===== Acciones ===== -->
                <div class="d-flex flex-column gap-2">
                    @if (esPropio)
                    {
                        <a href="@Url.Action("Editar", "Publicar", new { id = articulo.IdArticulos })" class="btn boton-bordo btn-lg">
                            <i class="bi bi-pencil-square me-1" aria-hidden="true"></i> Editar artículo
                        </a>
                        <button type="button" class="btn boton-contorno-bordo" data-bs-toggle="modal" data-bs-target="#modal-eliminar">
                            <i class="bi bi-trash3 me-1" aria-hidden="true"></i> Eliminar publicación
                        </button>
                        <a href="@Url.Action("Index", "Perfil")" class="btn boton-contorno-azul">Ver mis artículos publicados</a>
                    }
                    else if (idPropuestaEnCurso != null)
                    {
                        <a href="@Url.Action("Detalle", "Intercambio", new { id = idPropuestaEnCurso })" class="btn boton-bordo btn-lg" aria-describedby="propuesta-enviada">
                            <i class="bi bi-arrow-repeat me-1" aria-hidden="true"></i> Propuesta enviada
                        </a>
                        <span id="propuesta-enviada" class="texto-suave small text-center">Ya propusiste un intercambio por este artículo. Tocá el botón para ver cómo sigue.</span>
                    }
                    else if (comprometido)
                    {
                        <a href="@Url.Action("Buscar", "Articulos")" class="btn boton-contorno-azul btn-lg">Buscar otros artículos</a>
                    }
                    else if (logueado)
                    {
                        <button type="button" class="btn boton-bordo btn-lg" data-bs-toggle="modal" data-bs-target="#modal-proponer">
                            <i class="bi bi-arrow-left-right me-1" aria-hidden="true"></i> Proponer intercambio
                        </button>
                    }
                    else
                    {
                        <a href="@Url.Action("Index", "Account")" class="btn boton-bordo btn-lg">
                            <i class="bi bi-arrow-left-right me-1" aria-hidden="true"></i> Proponer intercambio
                        </a>
                        <span class="texto-suave small text-center">Iniciá sesión para proponer un intercambio.</span>
                    }
                </div>
            </div>
        </div>

        <!-- ===== Más artículos del mismo usuario ===== -->
        @if (otrosArticulos.Count > 0 && logueado)
        {
            <div class="col-12">
                <section class="seccion-simple" aria-labelledby="titulo-otros-articulos">
                    <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
                        <h2 class="letra-serif h3 mb-0" id="titulo-otros-articulos">
                            @if (esPropio) { <text>Tus otros artículos</text> } else { <text>Más artículos de @dueno.Nombre</text> }
                        </h2>
                        @if (!esPropio)
                        {
                            <a href="@Url.Action("Publico", "Perfil", new { id = dueno.IdUsuarios })" class="fw-semibold text-decoration-none texto-azul">Ver todos <i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                        }
                    </div>
                    <div class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-3">
                        @foreach (var otro in otrosArticulos)
                        {
                            ViewBag.articulo = otro;
                            <partial name="_CardObjeto" />
                        }
                    </div>
                </section>
            </div>
        }
    </div>
</div>

@if (puedeProponer)
{
    <!-- ===== Pop up: Proponer intercambio ===== -->
    <div class="modal fade ventana-redondeada" id="modal-proponer" tabindex="-1" aria-labelledby="titulo-proponer" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <form class="modal-content" method="post" action="@Url.Action("Proponer", "Intercambio")" asp-antiforgery="true"
                  data-proponer data-max-ofrecidos="@maxOfrecidos">
                <input type="hidden" name="idArticuloPedido" value="@articulo.IdArticulos">
                <div class="modal-header">
                    <h2 class="modal-title letra-serif h3 mb-0" id="titulo-proponer">Proponer intercambio</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                <div class="modal-body d-flex flex-column gap-3">
                    <p class="mb-0">Querés <strong>@articulo.Nombre</strong> de @@@dueno.Usuario. ¿Qué ofrecés a cambio?</p>

                    @if (misArticulos.Count > 0)
                    {
                        <fieldset class="d-flex flex-column gap-2" aria-describedby="@(misArticulos.Count > 1 ? "proponer-contador" : null)">
                            <legend class="leyenda-chica">
                                @leyendaOfrecer
                            </legend>
                            @{
                                ViewBag.opcionTipo = "checkbox";
                                ViewBag.opcionNombre = "idsArticulosOfrecidos";
                                ViewBag.opcionMarcada = misArticulos.Count == 1;
                                ViewBag.opcionRequerida = false;
                            }
                            @foreach (var mio in misArticulos)
                            {
                                ViewBag.opcion = mio;
                                <partial name="_OpcionArticulo" />
                            }
                        </fieldset>
                        @if (misArticulos.Count > 1)
                        {
                            <p class="texto-mini mb-0" id="proponer-contador" data-proponer-contador aria-live="polite">Podés ofrecer hasta @maxOfrecidos artículos juntos.</p>
                        }
                    }
                    else
                    {
                        <div class="text-center py-3">
                            <i class="bi bi-box-seam fs-1 texto-suave" aria-hidden="true"></i>
                            <p class="texto-suave mt-2 mb-3">Para proponer un intercambio necesitás tener al menos un artículo publicado.</p>
                            <a href="@Url.Action("Index", "Publicar")" class="btn boton-bordo btn-sm"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i> Publicar un artículo</a>
                        </div>
                    }

                    @if (misArticulos.Count > 0)
                    {
                        <p class="texto-mini mb-0"><i class="bi bi-info-circle me-1" aria-hidden="true"></i> @dueno.Nombre va a poder aceptar o rechazar tu propuesta. La seguís desde Mis intercambios.</p>
                    }
                </div>

                <div class="modal-footer">
                    <button type="button" class="boton-alto boton-blanco" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="boton-alto boton-azul" disabled="@(misArticulos.Count == 0)">Enviar propuesta</button>
                </div>
            </form>
        </div>
    </div>
}

@if (esPropio)
{
    <!-- ===== Pop up: confirmar que se elimina la publicación ===== -->
    <div class="modal fade ventana-redondeada" id="modal-eliminar" tabindex="-1" aria-labelledby="titulo-eliminar" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content" method="post" action="@Url.Action("Eliminar", "Publicar")" asp-antiforgery="true">
                <input type="hidden" name="id" value="@articulo.IdArticulos">
                <div class="modal-header">
                    <h2 class="modal-title letra-serif h3 mb-0" id="titulo-eliminar">¿Querés eliminar esta publicación?</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <p class="aviso-rosa mb-0"><i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i> Vas a eliminar <strong>@articulo.Nombre</strong>. Esta acción no se puede deshacer.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="boton-alto boton-blanco" data-bs-dismiss="modal">Volver</button>
                    <button type="submit" class="boton-alto boton-azul">Sí, eliminar</button>
                </div>
            </form>
        </div>
    </div>
}

@if (logueado && !esPropio)
{
    <form hidden data-reco-vista method="post" asp-antiforgery="true"
          action="@Url.Action("Vista", "Recomendaciones")" data-url-tiempo="@Url.Action("Tiempo", "Recomendaciones")">
        <input type="hidden" name="idArticulo" value="@articulo.IdArticulos">
    </form>
}

@section Scripts {
    <script src="~/js/articulo.js" asp-append-version="true"></script>
    <script src="~/js/recomendaciones.js" asp-append-version="true"></script>
}
