@using Swappit.Models.ViewModels
@{
    ViewData["Title"] = "Buscar";
    string? busqueda = ViewBag.busqueda;
    List<ArticuloCardViewModel> articulos = ViewBag.articulos;
    List<OpcionFiltroViewModel> categorias = ViewBag.categorias;
    List<OpcionFiltroViewModel> estados = ViewBag.estados;
    List<int> categoriasSeleccionadas = ViewBag.categoriasSeleccionadas;
    List<int> estadosSeleccionados = ViewBag.estadosSeleccionados;
    bool errorCarga = ViewBag.errorCarga;
    bool hayFiltros = ViewBag.hayFiltros;
}

<div class="container-xl py-4 py-lg-5">
    <div class="row g-4">

        <!-- ===== Filtros ===== -->
        <aside class="col-lg-3">
            <!-- En mobile se colapsa -->
            <button class="btn btn-sw-outline w-100 d-lg-none mb-2" type="button" data-bs-toggle="collapse" data-bs-target="#filtros">
                <i class="bi bi-funnel"></i> Filtros
            </button>

            <!-- Se envía por GET a Buscar: los filtros quedan en la URL y se combinan con la búsqueda (q) -->
            <form id="filtros" class="sw-filtros collapse d-lg-block @(hayFiltros ? "show" : "")" method="get" action="@Url.Action("Buscar", "Articulos")">
                @if (!string.IsNullOrEmpty(busqueda))
                {
                    <input type="hidden" name="q" value="@busqueda">
                }
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <span class="fs-5 fw-semibold"><i class="bi bi-filter-left"></i> Filtros</span>
                    @if (hayFiltros)
                    {
                        <a href="@Url.Action("Buscar", "Articulos", new { q = busqueda })" class="btn btn-link btn-sm text-suave text-decoration-none p-0">Limpiar</a>
                    }
                </div>

                <!-- Categoría: tabla Categorias. El número es cuántos artículos hay (respetando la búsqueda) -->
                <h6>Categoría</h6>
                <div id="filtro-categorias" class="mb-4">
                    @foreach (var cat in categorias)
                    {
                        var idCat = "cat-" + cat.Valor;
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="categoria" value="@cat.Valor" id="@idCat"
                                   checked="@(categoriasSeleccionadas.Any(c => c.ToString() == cat.Valor))">
                            <label class="form-check-label" for="@idCat">@cat.Texto</label>
                            <span class="contador">@cat.Cantidad</span>
                        </div>
                    }
                </div>

                <h6>Distancia</h6>
                <div class="mb-4">
                    @* Sin name: todavía no hay datos de ubicación en la BD para filtrar por distancia *@
                    <input type="range" class="form-range" id="filtro-distancia" min="0" max="20" value="5">
                    <div class="d-flex justify-content-between small text-suave">
                        <span>0 km</span>
                        <span class="fw-semibold text-dark">Hasta <span id="distancia-valor">5</span> km</span>
                        <span>20 km</span>
                    </div>
                </div>

                <!-- Estado: filas de la tabla EstadosArticulos -->
                <h6>Estado</h6>
                <div>
                    @foreach (var est in estados)
                    {
                        var idEst = "est-" + est.Valor;
                        <input type="checkbox" class="btn-check" name="estado" value="@est.Valor" id="@idEst"
                               checked="@(estadosSeleccionados.Any(e => e.ToString() == est.Valor))">
                        <label class="sw-chip" for="@idEst">@est.Texto <span class="visually-hidden">(@est.Cantidad)</span></label>
                    }
                </div>

                <!-- Con JS los filtros se aplican al marcarlos; sin JS se usa este botón -->
                <noscript><button type="submit" class="btn btn-sw-outline w-100 mt-4">Aplicar filtros</button></noscript>
            </form>
        </aside>

        <!-- ===== Resultados ===== -->
        <section class="col-lg-9">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                <h1 class="font-titulo h2 mb-0">
                    @if (string.IsNullOrEmpty(busqueda)) { <text>Los más buscados</text> }
                    else { <text>Resultados para “@busqueda”</text> }
                </h1>
                <div class="d-flex align-items-center gap-2">
                    <select class="form-select form-select-sm" id="ordenar" aria-label="Ordenar por" style="width:auto">
                        <option value="cercanos" selected>Más cercanos</option>
                        <option value="recientes">Más recientes</option>
                        <option value="az">A - Z</option>
                    </select>
                    <div class="btn-group btn-group-sm sw-vista-toggle" role="group" aria-label="Vista">
                        <input type="radio" class="btn-check" name="vista" id="vista-grilla" value="grilla" checked>
                        <label class="btn" for="vista-grilla" title="Grilla"><i class="bi bi-grid"></i></label>
                        <input type="radio" class="btn-check" name="vista" id="vista-lista" value="lista">
                        <label class="btn" for="vista-lista" title="Lista"><i class="bi bi-list-ul"></i></label>
                    </div>
                </div>
            </div>

            <!-- Artículos de la tabla Articulos (ArticulosController.Buscar → BD.GetArticulosCatalogo) -->
            <div id="lista-objetos" class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-3">
                @foreach (var articulo in articulos)
                {
                    ViewBag.articulo = articulo;
                    <partial name="_CardObjeto" />
                }
            </div>

            @if (errorCarga)
            {
                <div class="text-center py-5" role="alert">
                    <i class="bi bi-exclamation-circle fs-1 text-suave"></i>
                    <p class="text-suave mt-2">No pudimos cargar los objetos. Probá de nuevo en unos minutos.</p>
                </div>
            }
            else
            {
                <!-- Se muestra cuando no hay resultados -->
                <div id="sin-resultados" class="text-center py-5 @(articulos.Count > 0 ? "d-none" : "")">
                    <i class="bi bi-inbox fs-1 text-suave"></i>
                    <p class="text-suave mt-2">
                        @if (string.IsNullOrEmpty(busqueda) && !hayFiltros) { <text>Todavía no hay objetos publicados.</text> }
                        else { <text>No encontramos objetos con esos filtros.</text> }
                    </p>
                </div>
            }
        </section>
    </div>
</div>

@section Scripts {
    <script src="~/js/buscar.js" asp-append-version="true"></script>
}
