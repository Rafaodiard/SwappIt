@using Swappit.Models.ViewModels
@{
    ViewData["Title"] = "Buscar";
    string? busqueda = ViewBag.busqueda;
    List<ArticuloCardViewModel> articulos = ViewBag.articulos;
    List<int> categoriasSeleccionadas = ViewBag.categoriasSeleccionadas;
    bool errorCarga = ViewBag.errorCarga;
    string orden = ViewBag.orden;
    List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> opcionesOrden = ViewBag.opcionesOrden;
    string titulo = ViewBag.titulo;
    string textoSinResultados = ViewBag.textoSinResultados;
    bool registrarBusqueda = ViewBag.registrarBusqueda;
}

<div class="container-xl py-4 py-lg-5">
    <div class="row g-4">

        <!-- ===== Filtros ===== -->
        @{
            ViewBag.urlFiltros = Url.Action("Buscar", "Articulos");
            ViewBag.urlLimpiar = Url.Action("Buscar", "Articulos", new { q = busqueda, orden });
        }
        <partial name="_FiltrosArticulos" />

        <!-- ===== Resultados ===== -->
        <section class="col-lg-9 seccion-simple">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                <h1 class="letra-serif h2 mb-0">@titulo</h1>
                <div class="d-flex align-items-center gap-2">
                    <select class="form-select form-select-sm w-auto" id="ordenar" name="orden" form="filtros" aria-label="Ordenar por">
                        @foreach (var opcion in opcionesOrden)
                        {
                            <option value="@opcion.Value" selected="@(opcion.Value == orden)">@opcion.Text</option>
                        }
                    </select>
                    <div class="btn-group btn-group-sm grupo-botones-claro" role="group" aria-label="Vista">
                        <input type="radio" class="btn-check" name="vista" id="vista-grilla" value="grilla" checked>
                        <label class="btn" for="vista-grilla" title="Grilla"><i class="bi bi-grid" aria-hidden="true"></i><span class="visually-hidden">Ver en grilla</span></label>
                        <input type="radio" class="btn-check" name="vista" id="vista-lista" value="lista">
                        <label class="btn" for="vista-lista" title="Lista"><i class="bi bi-list-ul" aria-hidden="true"></i><span class="visually-hidden">Ver en lista</span></label>
                    </div>
                </div>
            </div>

            <div id="lista-objetos" class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-3">
                @foreach (var articulo in articulos)
                {
                    ViewBag.articulo = articulo;
                    <partial name="_CardObjeto" />
                }
            </div>

            @if (errorCarga)
            {
                <div class="text-center py-5" role="alert">
                    <i class="bi bi-exclamation-circle fs-1 texto-suave" aria-hidden="true"></i>
                    <p class="texto-suave mt-2">No pudimos cargar los objetos. Probá de nuevo en unos minutos.</p>
                </div>
            }
            else
            {
                <div id="sin-resultados" class="text-center py-5 @(articulos.Count > 0 ? "d-none" : "")">
                    <i class="bi bi-inbox fs-1 texto-suave" aria-hidden="true"></i>
                    <p class="texto-suave mt-2">@textoSinResultados</p>
                </div>
            }
        </section>
    </div>
</div>

@if (registrarBusqueda)
{
    <form hidden data-reco-busqueda method="post" asp-antiforgery="true" action="@Url.Action("Busqueda", "Recomendaciones")">
        <input type="hidden" name="texto" value="@busqueda">
        @foreach (int idCategoria in categoriasSeleccionadas)
        {
            <input type="hidden" name="categorias" value="@idCategoria">
        }
    </form>
}

@section Scripts {
    <script src="~/js/buscar.js" asp-append-version="true"></script>
    <script src="~/js/recomendaciones.js" asp-append-version="true"></script>
}
