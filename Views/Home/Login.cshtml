@{
    ViewData["Title"] = "Iniciar sesión";
    ViewData["Visitante"] = true;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-5">
            <form class="sw-form-card" method="post" asp-action="Login" novalidate>
                <h1 class="font-titulo text-center text-primario mb-4">Iniciar sesión</h1>

                <div class="mb-3">
                    <label for="Mail" class="form-label">Email</label>
                    <input type="email" class="form-control" id="Mail" name="Mail" required>
                </div>
                <div class="mb-2">
                    <label for="Contrasena" class="form-label">Contraseña</label>
                    <input type="password" class="form-control" id="Contrasena" name="Contrasena" required>
                </div>
                <div class="text-end mb-4">
                    <a href="#" class="small text-suave">¿Olvidaste tu contraseña?</a>
                </div>

                <button type="submit" class="btn btn-sw-primario w-100">Ingresar</button>
                <p class="small text-center mt-4 mb-0">¿No tenés cuenta? <a asp-action="Registro" class="fw-semibold text-secundario">Registrate</a></p>
            </form>
        </div>
    </div>
</div>
