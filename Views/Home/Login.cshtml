@model Swappit.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    ViewData["Visitante"] = true;
}

@*
    Pantalla derivada del diseño de "Registrarse" (no hay un frame de login
    en alta fidelidad): misma tarjeta, tipografías y componentes del UI Kit.
*@
<section class="sw-auth">
    <div class="sw-auth-card sw-auth-card--angosta">
        <header class="sw-auth-encabezado">
            <h1 class="sw-auth-titulo">Iniciá sesión</h1>
            <p class="sw-auth-subtitulo">Ingresá para seguir intercambiando</p>
        </header>

        <form class="sw-form" method="post" asp-controller="Home" asp-action="Login" novalidate>
            <!-- Errores generales (ej: "Email o contraseña incorrectos") -->
            <div asp-validation-summary="ModelOnly" class="sw-error-resumen" role="alert"></div>

            <div class="sw-campo">
                <label class="sw-label" asp-for="Mail"></label>
                <input class="sw-input" asp-for="Mail" type="email" placeholder="tunombre@@email.com" autocomplete="email" maxlength="50">
                <span class="sw-error" asp-validation-for="Mail"></span>
            </div>

            <div class="sw-campo">
                <label class="sw-label" asp-for="Contrasena"></label>
                <input class="sw-input" asp-for="Contrasena" type="password" placeholder="Tu contraseña" autocomplete="current-password" maxlength="50">
                <span class="sw-error" asp-validation-for="Contrasena"></span>
                <a href="#" class="sw-link sw-link-chico sw-campo-extra">¿Olvidaste tu contraseña?</a>
            </div>

            <div class="sw-form-acciones">
                <button type="submit" class="sw-btn sw-btn-solido sw-btn-bloque">Iniciar sesión</button>
            </div>
        </form>

        <p class="sw-auth-pie">
            <span>¿Todavía no tenés cuenta?</span>
            <a asp-controller="Home" asp-action="Registro" class="sw-link">Registrate</a>
        </p>
    </div>
</section>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
}
