@{
    ViewData["Title"] = "Mi perfil";
}

<div class="container-xl py-4 py-lg-5">
    <div class="row g-4">

        <!-- ===== Nombre + descripción ===== -->
        <div class="col-lg-6 d-flex flex-column gap-4">
            <div class="sw-card p-4">
                <div class="d-flex flex-column flex-sm-row align-items-center gap-4 text-center text-sm-start">
                    <div class="sw-perfil-avatar">
                        <span data-campo="iniciales">MG</span>
                        <button type="button" class="sw-perfil-avatar-editar border-0" aria-label="Cambiar foto"><i class="bi bi-camera-fill"></i></button>
                    </div>
                    <div>
                        <h1 class="font-titulo h2 mb-0" data-campo="nombreCompleto">Martina González</h1>
                        <p class="text-suave mb-3">@@<span data-campo="usuario">martinag</span></p>
                        <a href="#" class="btn btn-sw-primario btn-sm"><i class="bi bi-pencil-square me-1"></i> Editar perfil</a>
                    </div>
                </div>
            </div>

            <div class="sw-card p-4 flex-grow-1">
                <h2 class="h5 fw-bold mb-3">Descripción</h2>
                <p class="text-suave mb-0" data-campo="descripcion">
                    Me mudé hace poco a Palermo y estoy armando mi primer departamento. Busco muebles y cosas para la cocina; tengo ropa de cama, libros y objetos de decoración para intercambiar.
                </p>
            </div>
        </div>

        <!-- ===== Información personal (tabla Usuarios) ===== -->
        <div class="col-lg-6">
            <div class="sw-card p-4 h-100">
                <div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
                    <h2 class="h5 fw-bold mb-0">Información personal</h2>
                    <a href="#" class="text-suave" aria-label="Editar información"><i class="bi bi-pencil"></i></a>
                </div>
                <ul class="list-unstyled d-flex flex-column gap-4 mb-0">
                    <li class="d-flex align-items-center gap-3">
                        <span class="sw-info-icono"><i class="bi bi-person-fill"></i></span>
                        <span class="fw-semibold" style="width:150px">Usuario</span>
                        <span class="text-suave text-break" data-campo="usuario">@@martinag</span>
                    </li>
                    <li class="d-flex align-items-center gap-3">
                        <span class="sw-info-icono"><i class="bi bi-envelope-fill"></i></span>
                        <span class="fw-semibold" style="width:150px">Email</span>
                        <span class="text-suave text-break" data-campo="mail">martina.g@@gmail.com</span>
                    </li>
                    <li class="d-flex align-items-center gap-3">
                        <span class="sw-info-icono"><i class="bi bi-telephone-fill"></i></span>
                        <span class="fw-semibold" style="width:150px">Teléfono</span>
                        <span class="text-suave" data-campo="telefono">+54 9 11 1234-1234</span>
                    </li>
                    <li class="d-flex align-items-center gap-3">
                        <span class="sw-info-icono"><i class="bi bi-geo-alt-fill"></i></span>
                        <span class="fw-semibold" style="width:150px">Barrio</span>
                        <span class="text-suave" data-campo="barrio">Palermo, CABA</span>
                    </li>
                    <li class="d-flex align-items-center gap-3">
                        <span class="sw-info-icono"><i class="bi bi-calendar-fill"></i></span>
                        <span class="fw-semibold" style="width:150px">Edad</span>
                        <span class="text-suave" data-campo="edad">24 años</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- ===== Historial de intercambios (tabla Intercambios) ===== -->
        <div class="col-12">
            <div class="sw-card p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="font-titulo h3 mb-0">Historial de intercambios</h2>
                    <a href="#" class="fw-semibold text-decoration-none text-primario">Ver todos <i class="bi bi-chevron-right"></i></a>
                </div>

                <!-- Se llena desde JS: swappit.renderLista('#historial', lista, 'historial-item', rellenar) -->
                <div id="historial" class="d-flex flex-column gap-3">
                    <div class="sw-historial-item d-flex flex-column flex-md-row align-items-md-center gap-3" data-template="historial-item">
                        <div class="sw-historial-img sw-img"><img src="" alt="" data-campo="imagen"></div>
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <h3 class="h5 fw-bold mb-0" data-campo="articuloRecibido">Silla</h3>
                                <span class="sw-badge sw-badge-recibido" data-campo="tipo">Recibido</span>
                            </div>
                            <div class="text-suave small mb-1">
                                <i class="bi bi-arrow-left-right"></i> <span data-campo="articuloEntregado">Lámpara</span>
                            </div>
                            <div class="d-flex flex-wrap gap-3 text-suave small">
                                <span><i class="bi bi-person"></i> Intercambio con <span data-campo="otroUsuario">@@juanp</span></span>
                                <span><i class="bi bi-calendar3"></i> Fecha: <span data-campo="fecha">12/09/2026</span></span>
                            </div>
                        </div>
                        <a href="#" class="btn btn-sw-outline btn-sm">Ver intercambio <i class="bi bi-chevron-right"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
