@{
    ViewData["Title"] = "Inicio";
    List<Swappit.Models.ViewModels.ArticuloCardViewModel> destacados = ViewBag.destacados;
    List<Swappit.Models.ViewModels.PlanViewModel> planes = ViewBag.planes;
}

<!-- ===== Hero ===== -->
<section class="seccion-titulo-grande">
    <div class="container-xl">
        <div class="row align-items-center gx-4 gy-5">
            <div class="col-lg-6">
                <h1 class="mb-3">Swappit</h1>
                <p class="lead mb-2">Intercambiá. Conectá. Reutilizá.</p>
                <p class="texto-suave mb-4">Creemos en darle una segunda oportunidad a todo.</p>
                <a href="@Url.Action("Buscar", "Articulos")" class="btn boton-bordo btn-lg">Explorar productos</a>
            </div>
            <div class="col-lg-6">
                <div class="imagen-redondeada-grande marco-imagen"><img src="~/img/foto1.png" alt="Personas intercambiando objetos"></div>
            </div>
        </div>
    </div>
</section>

<!-- ===== Banda de valores ===== -->
<section class="franja-azul">
    <div class="container-xl">
        <div class="row gy-4">
            <div class="col-md-4 d-flex align-items-center gap-3 justify-content-md-center">
                <span class="cuadro-translucido"><i class="bi bi-arrow-left-right" aria-hidden="true"></i></span>
                <div><p class="titulo-mayusculas">Intercambiá</p><p>Lo que ya no usás</p></div>
            </div>
            <div class="col-md-4 d-flex align-items-center gap-3 justify-content-md-center">
                <span class="cuadro-translucido"><i class="bi bi-people" aria-hidden="true"></i></span>
                <div><p class="titulo-mayusculas">Conectá</p><p>Fácil y seguro</p></div>
            </div>
            <div class="col-md-4 d-flex align-items-center gap-3 justify-content-md-center">
                <span class="cuadro-translucido"><i class="bi bi-house-heart" aria-hidden="true"></i></span>
                <div><p class="titulo-mayusculas">Reutilizá</p><p>Sin gastar de más</p></div>
            </div>
        </div>
    </div>
</section>

<!-- ===== Qué es / Segunda vida ===== -->
<section class="seccion-amplia bg-white">
    <div class="container-xl">
        <div class="row align-items-center gx-4 gy-5 mb-5">
            <div class="col-lg-5 offset-lg-1">
                <div class="imagen-redondeada marco-imagen"><img src="~/img/foto2.png" alt=""></div>
            </div>
            <div class="col-lg-5">
                <h2>¿Qué es Swappit?</h2>
                <p class="texto-suave">SWAPPIT es una plataforma pensada para jóvenes que están comenzando a independizarse. Conectamos personas para que puedan intercambiar objetos que ya no usan por aquello que necesitan para su nuevo hogar.</p>
            </div>
        </div>
        <div class="row align-items-center gx-4 gy-5 flex-lg-row-reverse">
            <div class="col-lg-5 me-lg-auto">
                <div class="imagen-redondeada marco-imagen"><img src="~/img/foto3.jpg" alt=""></div>
            </div>
            <div class="col-lg-5 offset-lg-1 text-lg-end">
                <h2>Una segunda vida para cada objeto</h2>
                <p class="texto-suave">Buscamos hacer del intercambio una alternativa simple, segura y confiable. Queremos ayudar a ahorrar, aprovechar los objetos que ya existen y darles una segunda vida, evitando comprar por comprar.</p>
            </div>
        </div>
    </div>
</section>

<!-- ===== Cómo funciona ===== -->
<section class="seccion-amplia-crema" id="como-funciona">
    <div class="container-xl">
        <h2 class="mb-5 text-center">¿Cómo funciona?</h2>
        <div class="row gy-5">
            <div class="col-sm-6 col-lg-3 columna-numerada">
                <span class="circulo-bordo">01</span>
                <div class="cuadro-blanco-grande"><i class="bi bi-camera" aria-hidden="true"></i></div>
                <h3>Publicá</h3>
                <p>Subí los objetos que ya no usás y agregá fotos y detalles.</p>
            </div>
            <div class="col-sm-6 col-lg-3 columna-numerada">
                <span class="circulo-bordo">02</span>
                <div class="cuadro-blanco-grande"><i class="bi bi-search" aria-hidden="true"></i></div>
                <h3>Encontrá</h3>
                <p>Explorá lo que ofrecen otras personas y mirá en qué barrio está cada objeto.</p>
            </div>
            <div class="col-sm-6 col-lg-3 columna-numerada">
                <span class="circulo-bordo">03</span>
                <div class="cuadro-blanco-grande"><i class="bi bi-chat-heart" aria-hidden="true"></i></div>
                <h3>Conectá</h3>
                <p>Encontrá a alguien con quien hacer un intercambio y hablá por el chat.</p>
            </div>
            <div class="col-sm-6 col-lg-3 columna-numerada">
                <span class="circulo-bordo">04</span>
                <div class="cuadro-blanco-grande"><i class="bi bi-arrow-repeat" aria-hidden="true"></i></div>
                <h3>Intercambiá</h3>
                <p>Coordiná un punto de encuentro y dale una nueva vida a ese objeto.</p>
            </div>
        </div>
    </div>
</section>

<!-- ===== Todo en un lugar ===== -->
<section class="seccion-amplia bg-white">
    <div class="container-xl">
        <div class="row align-items-center gx-4 gy-5">
            <div class="col-lg-6 offset-lg-1">
                <h2 class="mb-4">Todo lo que necesitás, en un solo lugar</h2>
                <div class="fila-con-icono">
                    <span class="circulo-celeste-grande"><i class="bi bi-funnel" aria-hidden="true"></i></span>
                    <div><h3>Encontrá rápido</h3><p>Buscá por nombre y filtrá por categoría y estado.</p></div>
                </div>
                <div class="fila-con-icono">
                    <span class="circulo-celeste-grande"><i class="bi bi-chat-dots" aria-hidden="true"></i></span>
                    <div><h3>Hablá con usuarios</h3><p>Coordiná el intercambio directamente desde la app.</p></div>
                </div>
                <div class="fila-con-icono">
                    <span class="circulo-celeste-grande"><i class="bi bi-shield-check" aria-hidden="true"></i></span>
                    <div><h3>Intercambiá con confianza</h3><p>Conocé todos los detalles del objeto antes de verlo.</p></div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="imagen-redondeada cuadrada marco-imagen"><img src="~/img/foto4.jpg" alt=""></div>
            </div>
        </div>
    </div>
</section>

<!-- ===== Objetos destacados + CTA ===== -->
<section class="franja-azul-alta">
    <div class="container-xl">
        <h2 class="letra-serif text-center mb-4">Lo que ya no usás puede ser lo que alguien necesita</h2>

        @if (destacados.Count > 0)
        {
            <div id="objetos-destacados" class="row row-cols-2 row-cols-md-4 g-3 mb-4">
                @foreach (var articulo in destacados)
                {
                    ViewBag.articulo = articulo;
                    <partial name="_CardObjeto" />
                }
            </div>
        }

        <div class="caja-crema text-center">
            <h2 class="mb-2">¿Querés empezar a intercambiar?</h2>
            <p>Creá tu cuenta gratis y publicá tu primer objeto en minutos</p>
            <a href="@Url.Action("Registro", "Account")" class="btn boton-bordo">Registrate ahora <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i></a>
        </div>
    </div>
</section>

@if (planes.Count > 0)
{
    <!-- ===== Suscripciones ===== -->
    <section class="seccion-amplia-crema" aria-labelledby="titulo-suscripciones">
        <div class="container-xl">
            <div class="cabecera-angosta">
                <p class="antetitulo">Suscripciones</p>
                <h2 class="mb-3" id="titulo-suscripciones">Elegí tu plan</h2>
                <p class="texto-suave mb-0">Intercambiar en Swappit es gratis. Con Plus o Pro publicás y proponés más, y tus artículos se recomiendan más.</p>
            </div>
            <partial name="_GrillaPlanes" />
            <p class="text-center mt-4 mb-0"><a href="@Url.Action("Index", "Planes")" class="enlace-azul fw-semibold">Ver los planes en detalle <i class="bi bi-arrow-right" aria-hidden="true"></i></a></p>
        </div>
    </section>
}
