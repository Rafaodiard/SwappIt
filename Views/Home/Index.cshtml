@{
    ViewData["Title"] = "Inicio";
    List<Swappit.Models.ViewModels.ArticuloCardViewModel> destacados = ViewBag.destacados;
}

<!-- ===== Hero ===== -->
<section class="sw-hero">
    <div class="container-xl">
        <div class="row align-items-center gx-4 gy-5">
            <div class="col-lg-6">
                <h1 class="mb-3">Swappit</h1>
                <p class="lead mb-2">Intercambiá. Conectá. Reutilizá.</p>
                <p class="text-suave mb-4">Creemos en darle una segunda oportunidad a todo.</p>
                <a asp-controller="Articulos" asp-action="Buscar" class="btn btn-sw-primario btn-lg">Explorar productos</a>
            </div>
            <div class="col-lg-6">
                <div class="sw-hero-img sw-img"><img src="~/img/foto1.png" alt="Personas intercambiando objetos"></div>
            </div>
        </div>
    </div>
</section>

<!-- ===== Banda de valores ===== -->
<section class="sw-banda">
    <div class="container-xl">
        <div class="row gy-4">
            <div class="col-md-4 d-flex align-items-center gap-3 justify-content-md-center">
                <span class="sw-banda-icono"><i class="bi bi-arrow-left-right"></i></span>
                <div><h5>INTERCAMBIÁ</h5><p>Lo que ya no usás</p></div>
            </div>
            <div class="col-md-4 d-flex align-items-center gap-3 justify-content-md-center">
                <span class="sw-banda-icono"><i class="bi bi-people"></i></span>
                <div><h5>CONECTÁ</h5><p>Fácil y seguro</p></div>
            </div>
            <div class="col-md-4 d-flex align-items-center gap-3 justify-content-md-center">
                <span class="sw-banda-icono"><i class="bi bi-house-heart"></i></span>
                <div><h5>REUTILIZÁ</h5><p>Sin gastar de más</p></div>
            </div>
        </div>
    </div>
</section>

<!-- ===== Qué es / Segunda vida ===== -->
<section class="sw-seccion bg-white">
    <div class="container-xl">
        <div class="row align-items-center gx-4 gy-5 mb-5">
            <div class="col-lg-5 offset-lg-1">
                <div class="sw-seccion-img sw-img"><img src="~/img/foto2.png" alt=""></div>
            </div>
            <div class="col-lg-5">
                <h2>¿Qué es Swappit?</h2>
                <p class="text-suave">SWAPPIT es una plataforma pensada para jóvenes que están comenzando a independizarse. Conectamos personas para que puedan intercambiar objetos que ya no usan por aquello que necesitan para su nuevo hogar.</p>
            </div>
        </div>
        <div class="row align-items-center gx-4 gy-5 flex-lg-row-reverse">
            <div class="col-lg-5 me-lg-auto">
                <div class="sw-seccion-img sw-img"><img src="~/img/foto3.jpg" alt=""></div>
            </div>
            <div class="col-lg-5 offset-lg-1 text-lg-end">
                <h2>Una segunda vida para cada objeto</h2>
                <p class="text-suave">Buscamos hacer del intercambio una alternativa simple, segura y confiable. Queremos ayudar a ahorrar, aprovechar los objetos que ya existen y darles una segunda vida, evitando comprar por comprar.</p>
            </div>
        </div>
    </div>
</section>

<!-- ===== Cómo funciona ===== -->
<section class="sw-seccion bg-crema" id="como-funciona">
    <div class="container-xl">
        <h2 class="mb-5 text-center">¿Cómo funciona?</h2>
        <div class="row gy-5">
            <div class="col-sm-6 col-lg-3 sw-paso">
                <span class="sw-paso-num">01</span>
                <div class="sw-paso-icono"><i class="bi bi-camera"></i></div>
                <h5>PUBLICÁ</h5>
                <p>Subí los objetos que ya no usás y agregá fotos y detalles.</p>
            </div>
            <div class="col-sm-6 col-lg-3 sw-paso">
                <span class="sw-paso-num">02</span>
                <div class="sw-paso-icono"><i class="bi bi-search"></i></div>
                <h5>ENCONTRÁ</h5>
                <p>Explorá objetos que otras personas están ofreciendo cerca tuyo.</p>
            </div>
            <div class="col-sm-6 col-lg-3 sw-paso">
                <span class="sw-paso-num">03</span>
                <div class="sw-paso-icono"><i class="bi bi-chat-heart"></i></div>
                <h5>CONECTÁ</h5>
                <p>Encontrá a alguien con quien hacer un intercambio y hablá por el chat.</p>
            </div>
            <div class="col-sm-6 col-lg-3 sw-paso">
                <span class="sw-paso-num">04</span>
                <div class="sw-paso-icono"><i class="bi bi-arrow-repeat"></i></div>
                <h5>INTERCAMBIÁ</h5>
                <p>Coordiná un punto de encuentro y dale una nueva vida a ese objeto.</p>
            </div>
        </div>
    </div>
</section>

<!-- ===== Todo en un lugar ===== -->
<section class="sw-seccion bg-white">
    <div class="container-xl">
        <div class="row align-items-center gx-4 gy-5">
            <div class="col-lg-6 offset-lg-1">
                <h2 class="mb-4">Todo lo que necesitás, en un solo lugar</h2>
                <div class="sw-feature">
                    <span class="sw-feature-icono"><i class="bi bi-geo-alt"></i></span>
                    <div><h6>Encontrá cerca</h6><p>Buscá objetos según tu ubicación.</p></div>
                </div>
                <div class="sw-feature">
                    <span class="sw-feature-icono"><i class="bi bi-chat-dots"></i></span>
                    <div><h6>Hablá con usuarios</h6><p>Coordiná el intercambio directamente desde la app.</p></div>
                </div>
                <div class="sw-feature">
                    <span class="sw-feature-icono"><i class="bi bi-shield-check"></i></span>
                    <div><h6>Intercambiá con confianza</h6><p>Conocé todos los detalles del objeto antes de verlo.</p></div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="sw-seccion-img sw-img" style="aspect-ratio:1"><img src="~/img/foto4.jpg" alt=""></div>
            </div>
        </div>
    </div>
</section>

<!-- ===== Objetos destacados + CTA ===== -->
<section class="sw-cta">
    <div class="container-xl">
        <h2 class="font-titulo text-center mb-4">Lo que ya no usás puede ser lo que alguien necesita</h2>

        <!-- Los 4 artículos más recientes (HomeController.Index) -->
        @if (destacados.Count > 0)
        {
            <div id="objetos-destacados" class="row row-cols-2 row-cols-md-4 g-3 mb-4">
                @foreach (var articulo in destacados)
                {
                    ViewBag.articulo = articulo;
                    <partial name="_CardObjeto" />
                }
            </div>
        }

        <div class="sw-cta-box text-center">
            <h2 class="mb-2">¿Querés empezar a intercambiar?</h2>
            <p>Creá tu cuenta gratis y publicá tu primer objeto en minutos</p>
            <a asp-controller="Account" asp-action="Registro" class="btn btn-sw-secundario">Registrate ahora <i class="bi bi-arrow-right ms-1"></i></a>
        </div>
    </div>
</section>
