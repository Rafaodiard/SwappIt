@using Swappit.Models.ViewModels
@model PublicarArticuloViewModel
@{
    ViewData["Title"] = "Publicar objeto";
}

<section class="sw-publicar">
    <div class="sw-publicar-wrap">

        <header class="sw-publicar-encabezado">
            <h1 class="sw-auth-titulo">Publicá tu objeto</h1>
            <p class="sw-auth-subtitulo">Subí fotos, contá cómo está y elegí qué te gustaría recibir a cambio</p>
        </header>

        <form class="sw-publicar-card" method="post" enctype="multipart/form-data" asp-controller="Home" asp-action="Publicar" novalidate>

            <!-- ===== Columna izquierda: fotos ===== -->
            <div class="sw-publicar-fotos">
                <div class="sw-campo">
                    <span class="sw-label" id="etiqueta-fotos">Fotos del objeto</span>
                    <span class="sw-ayuda">La primera foto va a ser la portada de tu publicación.</span>
                </div>

                <!-- Zona de carga: clic o arrastrar. El input real está oculto. -->
                <div class="sw-zona-carga" id="zona-carga" role="button" tabindex="0" aria-labelledby="etiqueta-fotos">
                    <span class="sw-zona-carga-icono"><i class="bi bi-camera" aria-hidden="true"></i></span>
                    <p class="sw-zona-carga-titulo">Arrastrá tus fotos acá</p>
                    <p class="sw-zona-carga-ayuda">o hacé clic para buscarlas en tu dispositivo</p>
                    <button type="button" class="sw-btn sw-btn-contorno" id="boton-subir-fotos" tabindex="-1">Subir fotos</button>
                </div>
                <input asp-for="Fotos" id="Fotos" type="file" accept="image/jpeg,image/png" multiple hidden>

                <!-- Miniaturas: 4 espacios vacíos; publicar.js las completa con las fotos elegidas -->
                <div class="sw-miniaturas" id="miniaturas">
                    <button type="button" class="sw-miniatura" aria-label="Agregar foto">+</button>
                    <button type="button" class="sw-miniatura" aria-label="Agregar foto">+</button>
                    <button type="button" class="sw-miniatura" aria-label="Agregar foto">+</button>
                    <button type="button" class="sw-miniatura" aria-label="Agregar foto">+</button>
                </div>

                <p class="sw-nota">Hasta @PublicarArticuloViewModel.MaxFotos fotos · JPG o PNG · máx. 10 MB</p>
                <span class="sw-error" asp-validation-for="Fotos"></span>
            </div>

            <!-- ===== Columna derecha: datos ===== -->
            <div class="sw-publicar-datos">
                <div asp-validation-summary="ModelOnly" class="sw-error-resumen" role="alert"></div>

                <div class="sw-campo">
                    <label class="sw-label" asp-for="Titulo"></label>
                    <input class="sw-input" asp-for="Titulo" placeholder="Ej: Silla de madera estilo nórdico" maxlength="50">
                    <span class="sw-error" asp-validation-for="Titulo"></span>
                </div>

                <div class="sw-fila">
                    <div class="sw-campo">
                        <label class="sw-label" asp-for="IdCategorias"></label>
                        <select class="sw-input sw-select" asp-for="IdCategorias" asp-items="Model.Categorias" required>
                            <option value="" disabled selected>Elegí una categoría</option>
                        </select>
                        <span class="sw-error" asp-validation-for="IdCategorias"></span>
                    </div>
                    <div class="sw-campo">
                        <label class="sw-label" asp-for="Ubicacion"></label>
                        <input class="sw-input" asp-for="Ubicacion" placeholder="Palermo, CABA" maxlength="100">
                        <span class="sw-error" asp-validation-for="Ubicacion"></span>
                    </div>
                </div>

                <div class="sw-campo sw-campo-estado">
                    <span class="sw-label" id="etiqueta-estado">Estado del objeto</span>
                    <div class="sw-estados" role="radiogroup" aria-labelledby="etiqueta-estado">
                        @foreach (var estado in PublicarArticuloViewModel.Estados)
                        {
                            var idEstado = "Estado_" + estado.Replace(" ", "_");
                            <input type="radio" class="sw-estado-radio" id="@idEstado" name="Estado" value="@estado" checked="@(Model.Estado == estado)">
                            <label class="sw-estado" for="@idEstado">@estado</label>
                        }
                    </div>
                    <span class="sw-error" asp-validation-for="Estado"></span>
                </div>

                <div class="sw-campo">
                    <label class="sw-label" asp-for="Descripcion"></label>
                    <textarea class="sw-input sw-textarea" asp-for="Descripcion" rows="5" maxlength="@PublicarArticuloViewModel.MaxDescripcion" placeholder="Contá medidas, antigüedad, detalles o marcas de uso…"></textarea>
                    <span class="sw-contador" id="contador-descripcion" aria-live="polite">0/@PublicarArticuloViewModel.MaxDescripcion</span>
                    <span class="sw-error" asp-validation-for="Descripcion"></span>
                </div>

                <div class="sw-campo">
                    <label class="sw-label" asp-for="ACambio"></label>
                    <span class="sw-ayuda">Podés poner varias opciones o dejarlo abierto a propuestas.</span>
                    <input class="sw-input" asp-for="ACambio" placeholder="Ej: una lámpara, libros, plantas…" maxlength="100">
                    <span class="sw-error" asp-validation-for="ACambio"></span>
                </div>

                <hr class="sw-divisor">

                <div class="sw-publicar-acciones">
                    <a asp-controller="Home" asp-action="Index" class="sw-btn sw-btn-contorno">Cancelar</a>
                    <button type="submit" class="sw-btn sw-btn-solido">Publicar objeto</button>
                </div>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/publicar.js" asp-append-version="true"></script>
}
