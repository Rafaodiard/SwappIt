@model Swappit.Models.ViewModels.RegistroViewModel
@{
    ViewData["Title"] = "Registrarse";
    ViewData["Visitante"] = true;
}

<section class="sw-auth">
    <div class="sw-auth-card">
        <header class="sw-auth-encabezado">
            <h1 class="sw-auth-titulo">Registrate</h1>
            <p class="sw-auth-subtitulo">Creá tu cuenta y empezá a intercambiar</p>
        </header>

        <form class="sw-form" method="post" asp-controller="Home" asp-action="Registro" novalidate>
            <div asp-validation-summary="ModelOnly" class="sw-error-resumen" role="alert"></div>

            <div class="sw-fila">
                <div class="sw-campo">
                    <label class="sw-label" asp-for="Nombre"></label>
                    <input class="sw-input" asp-for="Nombre" placeholder="Martina" autocomplete="given-name" maxlength="50">
                    <span class="sw-error" asp-validation-for="Nombre"></span>
                </div>
                <div class="sw-campo">
                    <label class="sw-label" asp-for="Apellido"></label>
                    <input class="sw-input" asp-for="Apellido" placeholder="González" autocomplete="family-name" maxlength="50">
                    <span class="sw-error" asp-validation-for="Apellido"></span>
                </div>
            </div>

            <div class="sw-campo">
                <label class="sw-label" asp-for="Mail"></label>
                <input class="sw-input" asp-for="Mail" type="email" placeholder="tunombre@@email.com" autocomplete="email" maxlength="50">
                <span class="sw-error" asp-validation-for="Mail"></span>
            </div>

            <div class="sw-campo">
                <label class="sw-label" asp-for="Contrasena"></label>
                <input class="sw-input" asp-for="Contrasena" type="password" placeholder="Mínimo 8 caracteres" autocomplete="new-password" maxlength="50">
                <span class="sw-error" asp-validation-for="Contrasena"></span>
            </div>

            <div class="sw-fila">
                <div class="sw-campo">
                    <label class="sw-label" asp-for="FechaNacimiento"></label>
                    <div class="sw-input-icono">
                        <i class="bi bi-calendar3" aria-hidden="true"></i>
                        <input class="sw-input" asp-for="FechaNacimiento" type="date" autocomplete="bday">
                    </div>
                    <span class="sw-error" asp-validation-for="FechaNacimiento"></span>
                </div>
                <div class="sw-campo">
                    <label class="sw-label" asp-for="Telefono"></label>
                    <input class="sw-input" asp-for="Telefono" type="tel" placeholder="+54 9 11 0000-0000" autocomplete="tel">
                    <span class="sw-error" asp-validation-for="Telefono"></span>
                </div>
            </div>

            <div class="sw-form-acciones">
                <button type="submit" class="sw-btn sw-btn-solido sw-btn-bloque">Crear cuenta</button>
            </div>
        </form>

        <p class="sw-auth-pie">
            <span>¿Ya tenés cuenta?</span>
            <a asp-controller="Home" asp-action="Login" class="sw-link">Iniciar sesión</a>
        </p>
    </div>
</section>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
}
